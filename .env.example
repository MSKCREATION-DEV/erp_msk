# === Supabase (projet erp_msk) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prisma : URL app (pooler 6543 recommandé en prod) + directe migrations
DATABASE_URL=
DIRECT_URL=

# === Resend (dev) ===
RESEND_API_KEY=
# Domaine vérifié Resend ; interim possible: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
EMAIL_TEST_TO=a.guiro@mskcreation.net

# === Bootstrap Super Admin (dev only) ===
# Mot de passe initial si le compte n'existe pas encore.
# Pour RÉÉCRIRE le MDP d'un compte existant au seed, il faut AUSSI :
# BOOTSTRAP_FORCE_PASSWORD=1
BOOTSTRAP_TEMP_PASSWORD=
# BOOTSTRAP_FORCE_PASSWORD=

# Pooler Supabase + Node récent : parfois requis en local
NODE_TLS_REJECT_UNAUTHORIZED=0

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
