# === Supabase (projet erp_msk) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prisma (Vercel) :
# DATABASE_URL = pooler Transaction :6543 (?pgbouncer=true) — runtime
# DIRECT_URL   = même host pooler :5432 (Session) — migrate deploy uniquement
# Ne pas utiliser db.*.supabase.co sur Vercel (build qui hang).
DATABASE_URL=
DIRECT_URL=

# === Resend (dev) ===
RESEND_API_KEY=
# Domaine vérifié Resend ; prod: MSK CREATION <notifications@mskcreation.net>
EMAIL_FROM=MSK CREATION <notifications@mskcreation.net>
EMAIL_TEST_TO=a.guiro@mskcreation.net
# Logos = pièces jointes CID (pas d’URL publique requise ; Vercel Protection OK)
# Liens CTA si NEXT_PUBLIC_APP_URL est localhost (sinon = APP_URL)
# EMAIL_CTA_BASE_URL=https://erp-msk.vercel.app

# === Bootstrap Super Admin (dev only) ===
# MDP initial UNIQUEMENT si le compte Auth n'existe pas encore (createUser).
# Compte déjà ACTIVE : JAMAIS réécrit (même avec FORCE).
# FORCE n'agit que sur invite / must_change_password (jamais ACTIVE).
BOOTSTRAP_TEMP_PASSWORD=
# BOOTSTRAP_FORCE_PASSWORD=

# Pooler Supabase + Node récent : parfois requis en local
NODE_TLS_REJECT_UNAUTHORIZED=0

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
