# === Supabase (projet erp_msk) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prisma :
# DATABASE_URL = pooler Transaction :6543 (?pgbouncer=true) — JAMAIS Session :5432 en prod Vercel
# DIRECT_URL   = directe db.*.supabase.co:5432 (migrations)
DATABASE_URL=
DIRECT_URL=

# === Resend (dev) ===
RESEND_API_KEY=
# Domaine vérifié Resend ; interim possible: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
EMAIL_TEST_TO=a.guiro@mskcreation.net

# === Bootstrap Super Admin (dev only) ===
# MDP initial UNIQUEMENT si le compte Auth n'existe pas encore (createUser).
# Compte déjà ACTIVE : JAMAIS réécrit (même avec FORCE).
# FORCE n'agit que sur invite / must_change_password (jamais ACTIVE).
BOOTSTRAP_TEMP_PASSWORD=
# BOOTSTRAP_FORCE_PASSWORD=

# Pooler Supabase + Node récent : parfois requis en local
NODE_TLS_REJECT_UNAUTHORIZED=0

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
