# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client Prisma 7 (output custom) : versionné pour que l’IDE / Cursor
# résolve `@/generated/prisma/client` (sinon TS2307 + indexation ignorée).
# Régénéré par `postinstall` / `prisma generate` — committer après changement de schema.

# Skills Prisma auto-générés (doublons hors Cursor)
.agents/
.claude/
.devin/
tmp/

# Docs RH / contrats personnels (ne jamais versionner)
docs/ATTESTATION*
docs/CONTRAT DE*
docs/Contrat*
docs/Document*
docs/Fiche de Paie*
docs/Solde de tout compte*
Réunion*.vtt
*.vtt
