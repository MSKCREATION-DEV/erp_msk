  updatedAt     DateTime          @updatedAt

  employee    RhEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  owner       User               @relation("RhTimesheetOwner", fields: [ownerId], references: [id])
  validatedBy User?              @relation("RhTimesheetValidator", fields: [validatedById], references: [id])
  lines       RhTimesheetLine[]

  @@unique([employeeId, weekStart])
  @@index([status, weekStart])
  @@map("rh_timesheets")
}

model RhTimesheetLine {
  id           String   @id @default(cuid())
  timesheetId  String
  workDate     DateTime @db.Date
  minutes      Int      @default(0)
  label        String?

  timesheet RhTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
  @@map("rh_timesheet_lines")
}

