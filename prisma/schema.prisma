// ERP MSK CREATION — Phase 0 IAM + Phase 1 GED
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  INVITE_PENDING
  MUST_CHANGE_PASSWORD
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OverrideEffect {
  GRANT
  DENY
}

enum ResetRequestStatus {
  PENDING
  DONE
  CANCELLED
}

enum DocVisibility {
  PRIVATE_SELF
  GROUP
  RH_ONLY
  DIRECTION
  COMPANY
  CUSTOM
}

enum DocStatus {
  ACTIVE
  ARCHIVED
  TRASH
}

enum AclRight {
  VIEW
  UPLOAD
  EDIT_META
  MANAGE_SHARE
}

enum SignatureKind {
  UPLOAD
}

enum SignatureStatus {
  DRAFT
  ACTIVE
  REVOKED
}

enum TemplateType {
  DEVIS
  FACTURE
}

/// Singleton single-tenant MSK (id fixe = "msk")
model OrganizationSettings {
  id               String   @id @default("msk")
  legalName        String   @default("MSK CREATION")
  tradeName        String   @default("MSK CREATION")
  defaultCurrency  String   @default("XOF")
  defaultVatRate   Decimal  @default(18.00) @db.Decimal(5, 2)
  frVatRate        Decimal  @default(20.00) @db.Decimal(5, 2)
  countryCode      String   @default("ML")
  timezone         String   @default("Africa/Bamako")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("organization_settings")
}

/// Profil applicatif lié à auth.users (id = UUID Supabase Auth)
model User {
  id                 String     @id @db.Uuid
  email              String     @unique
  firstName          String
  lastName           String
  phone              String?
  status             UserStatus @default(INVITE_PENDING)
  isSuperAdmin       Boolean    @default(false)
  mustChangePassword Boolean    @default(true)
  invitedAt          DateTime?
  activatedAt        DateTime?
  lastLoginAt        DateTime?
  suspendedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  groupMembers   GroupMember[]
  userPacks      UserPack[]
  overrides      UserPermissionOverride[]
  auditLogs      AuditLog[]              @relation("AuditActor")
  resetRequests  PasswordResetRequest[]  @relation("ResetSubject")
  resetsResolved PasswordResetRequest[]  @relation("ResetResolver")
  foldersCreated DocumentFolder[]        @relation("FolderCreator")
  docsCreated    Document[]              @relation("DocCreator")
  documentAcls   DocumentAcl[]
  signatures     SignatureAsset[]
  orgNodes       OrgNode[]

  @@index([status])
  @@map("users")
}

model Group {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String?
  defaultPackId String?
  sortOrder     Int     @default(0)

  defaultPack PermissionPack? @relation("GroupDefaultPack", fields: [defaultPackId], references: [id], onDelete: SetNull)
  members     GroupMember[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  domain      String
  description String?

  packItems PackPermission[]
  overrides UserPermissionOverride[]

  @@index([domain])
  @@map("permissions")
}

model PermissionPack {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)

  permissions   PackPermission[]
  userPacks     UserPack[]
  groupsDefault Group[]          @relation("GroupDefaultPack")

  @@map("permission_packs")
}

model PackPermission {
  packId       String
  permissionId String

  pack       PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([packId, permissionId])
  @@map("pack_permissions")
}

model UserPack {
  userId    String   @db.Uuid
  packId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([userId, packId])
  @@index([packId])
  @@map("user_packs")
}

model UserPermissionOverride {
  id           String         @id @default(cuid())
  userId       String         @db.Uuid
  permissionId String
  effect       OverrideEffect
  reason       String?
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PasswordResetRequest {
  id                String             @id @default(cuid())
  userId            String             @db.Uuid
  requesterEmail    String?
  status            ResetRequestStatus @default(PENDING)
  note              String?
  createdAt         DateTime           @default(now())
  resolvedAt        DateTime?
  resolvedById      String?            @db.Uuid

  user       User  @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ResetResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("password_reset_requests")
}

// ─── Phase 1 GED ───────────────────────────────────────────────

model DocumentFolder {
  id         String        @id @default(cuid())
  parentId   String?
  name       String
  code       String
  path       String
  year       Int?
  visibility DocVisibility @default(COMPANY)
  createdById String?      @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]
  acls      DocumentAcl[]
  createdBy User?            @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([path])
  @@index([parentId])
  @@index([year])
  @@index([code])
  @@map("document_folders")
}

model Document {
  id           String        @id @default(cuid())
  folderId     String
  storagePath  String
  originalName String
  mime         String
  size         Int
  checksum     String?
  version      Int           @default(1)
  status       DocStatus     @default(ACTIVE)
  visibility   DocVisibility @default(COMPANY)
  createdById  String?       @db.Uuid
  softDeletedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  folder    DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("DocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  links     DocumentLink[]
  acls      DocumentAcl[]

  @@index([folderId])
  @@index([status])
  @@index([softDeletedAt])
  @@map("documents")
}

model DocumentLink {
  id         String @id @default(cuid())
  documentId String
  entityType String
  entityId   String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

model DocumentAcl {
  id         String    @id @default(cuid())
  folderId   String?
  documentId String?
  userId     String    @db.Uuid
  right      AclRight  @default(VIEW)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([documentId])
  @@index([userId])
  @@map("document_acls")
}

model BrandAsset {
  id        String   @id @default(cuid())
  kind      String   @unique
  label     String
  publicPath String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_assets")
}

model SignatureAsset {
  id              String          @id @default(cuid())
  ownerUserId     String?         @db.Uuid
  orgOwned        Boolean         @default(false)
  kind            SignatureKind   @default(UPLOAD)
  label           String
  storageOriginal String
  mime            String
  status          SignatureStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([status])
  @@map("signature_assets")
}

model OrgNode {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  title     String
  fullName  String
  email     String?
  photoPath String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   OrgNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgNode[] @relation("OrgTree")

  @@index([parentId])
  @@index([sortOrder])
  @@map("org_nodes")
}

model DocumentTemplate {
  id            String       @id @default(cuid())
  type          TemplateType
  code          String       @unique
  name          String
  version       Int          @default(1)
  structureJson Json         @default("{}")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@map("document_templates")
}
