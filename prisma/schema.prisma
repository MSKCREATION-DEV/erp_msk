  leaveMovements RhLeaveMovement[]

  @@index([status, lastName])
  @@index([managerEmployeeId])
  @@map("rh_employees")
}

enum RhProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model RhProfileChangeRequest {
  id           String                 @id @default(cuid())
  employeeId   String
  requesterId  String                 @db.Uuid
