enum RhPayrollPeriodStatus {
  DRAFT
  OPEN
  CALCULATED
  APPROVED
  CLOSED
}

enum RhPayslipStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum RhInpsLineStatus {
  DRAFT
  CALCULATED
  DECLARED
  PAID
}

/// Paramètres cotisations (versionnés). ratesJson = [{code,label,rate,party}]
model RhInpsSettings {
  id                String   @id @default(cuid())
  effectiveFrom     DateTime @db.Date
  ratesJson         Json
  declarationPeriod String   @default("monthly")
  paymentDueDay     Int      @default(15)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([effectiveFrom])
  @@map("rh_inps_settings")
}

model RhPayrollPeriod {
  id           String                @id @default(cuid())
  year         Int
  month        Int
  status       RhPayrollPeriodStatus @default(OPEN)
  openedById   String                @db.Uuid
  approvedById String?               @db.Uuid
  approvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  openedBy   User         @relation("RhPayrollOpener", fields: [openedById], references: [id])
  approvedBy User?        @relation("RhPayrollApprover", fields: [approvedById], references: [id])
