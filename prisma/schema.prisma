model RhEmployee {
  id               String            @id @default(cuid())
  userId           String?           @unique @db.Uuid
  firstName        String
  lastName         String
  /// Nom de naissance (si distinct).
  birthName        String?
  email            String?
  phone            String?
  personalEmail    String?
  personalPhone    String?
  jobTitle         String?
  department       String?
  workLocation     String?
  employeeCode     String?
  employeeType     RhEmployeeType    @default(SALARIE)
  status           RhEmployeeStatus  @default(ACTIVE)
  hireDate         DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  birthDate        DateTime?         @db.Date
  birthPlace       String?
  nationality      String?
  gender           String?
  idDocumentType   String?
  idDocumentNumber String?
  idIssuedOn       DateTime?         @db.Date
  idExpiresOn      DateTime?         @db.Date
  idIssuedBy       String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  postalCode       String?
  country          String?           @default("Mali")
  emergencyContact String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bankName         String?
  bankAccountHolder String?
  /// IBAN / RIB — accès masqué côté UI collab.
  bankIban         String?
  managerEmployeeId String?
  leaveBalanceDays Decimal           @default(0) @db.Decimal(6, 2)
  reglementStatus  RhReglementStatus @default(PENDING)
  reglementSignedAt DateTime?
