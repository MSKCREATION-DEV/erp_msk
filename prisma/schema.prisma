  projectId        String
  expenseDate      DateTime         @db.Date
  nature           String
  description      String?
  plannedXof       Int              @default(0)
  spentXof         Int
  paymentMode      String?
  status           PrjExpenseStatus @default(DRAFT)
  justificatifNote String?
  createdById      String           @db.Uuid
  reviewedById     String?          @db.Uuid
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project   PrjProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User       @relation("PrjExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("PrjExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("prj_expenses")
}

model OpsTicket {
  id           String            @id @default(cuid())
  equipment    String
  problem      String
  priority     OpsTicketPriority @default(MEDIUM)
  status       OpsTicketStatus   @default(TODO)
  actionPlan   String?
  observations String?
  assignedToId String?           @db.Uuid
  createdById  String            @db.Uuid
  noticedAt    DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignedTo User? @relation("OpsTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User  @relation("OpsTicketCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, priority])
  @@index([assignedToId])
  @@map("ops_tickets")
}

// ─── Suivi tampon (isolé) ─────────────────────────────────────

enum SvInvoiceStatus {
  BROUILLON
  EMISE
  PARTIELLE
  PAYEE
  ANNULEE
}

/// Type de charge entreprise (factures internes / fournisseurs).
enum SvExpenseCategory {
  ORANGE_INTERNET
  EDM_ELECTRICITE
  LOYER
  AUTRE
}

enum SvCashDirection {
  IN
  OUT
}

enum SvAccountKind {
  PHYSICAL
  BANK
}

enum SvStockMoveKind {
  IN
  OUT
  ADJUST
}

model SvClient {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  city        String?
  country     String?
  notes       String?
  sourceRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices  SvInvoice[]
  contracts SvContractMeta[]
  movements SvCashMovement[]

  @@index([name])
  @@map("sv_clients")
}

model SvInvoice {
  id             String          @id @default(cuid())
  number         String?
  legacyNumber   String?
  status         SvInvoiceStatus @default(BROUILLON)
  clientId       String
  issuedAt       DateTime?
  dueAt          DateTime?
  totalHt        Int             @default(0)
  totalVat       Int             @default(0)
  totalTtc       Int             @default(0)
  amountPaid     Int             @default(0)
  currency       String          @default("XOF")
  vatRate        Int             @default(18)
  object         String?
  notes          String?
  sourceDocument String?
  remixedFromId  String?
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  client      SvClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  remixedFrom SvInvoice?       @relation("SvInvoiceRemix", fields: [remixedFromId], references: [id], onDelete: SetNull)
  remixes     SvInvoice[]      @relation("SvInvoiceRemix")
  lines       SvInvoiceLine[]
  payments    SvPayment[]
  movements   SvCashMovement[]
  createdBy   User             @relation("SvInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clientId, status])
  @@index([number])
  @@index([issuedAt])
  @@map("sv_invoices")
}

model SvInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  sortOrder   Int     @default(0)
  label       String
  description String?
  qty         Int     @default(1)
  unitPrice   Int     @default(0)
  vatRate     Int?

  invoice SvInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("sv_invoice_lines")
}

model SvPayment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  reference String?
  note      String?
  createdAt DateTime @default(now())

  invoice   SvInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  movements SvCashMovement[]

  @@index([invoiceId, paidAt])
  @@map("sv_payments")
}

model SvContractMeta {
  id             String    @id @default(cuid())
  clientId       String
  title          String
  partyName      String?
  effectiveFrom  DateTime?
  durationNote   String?
  monthlyAmount  Int?
  sourceDocument String?
  gedDocumentId  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client SvClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("sv_contracts")
}

/// Compte trésorerie tampon (caisse physique ou banque).
/// Solde courant = Σ IN − Σ OUT des mouvements liés avec `countsTowardBalance=true`
/// (écritures d’ouverture bascule Direction + mouvements post-bascule).
model SvAccount {
  id              String        @id @default(cuid())
  kind            SvAccountKind @unique
  label           String
  notes           String?
  /// Instant de bascule Direction (début de journée locale Bamako = UTC).
  baselineAt      DateTime?
  /// Solde documenté à la bascule (FCFA) — UI « Solde au … » ; source ledger = mouvement IN ouverture.
  baselineBalance Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  movements SvCashMovement[]

  @@map("sv_accounts")
}

model SvCashMovement {
  id              String          @id @default(cuid())
  movedAt         DateTime
  direction       SvCashDirection
  amount          Int
  category        String
  description     String?
  clientProject   String?
  beneficiary     String?
  paymentMethod   String?
  paidBy          String?
  reference       String?
  /// Compte impacté (physique ou banque). Null = legacy hors compte.
  accountId       String?
  /// Même id sur les 2 jambes d’un transfert banque ↔ physique.
  transferId      String?
  /// false = archive pre-bascule (visible historique, exclu du solde courant).
  countsTowardBalance Boolean     @default(true)
  linkedClientId           String?
  linkedInvoiceId          String?
  linkedPaymentId          String?
  linkedExpenseInvoiceId   String?
  linkedExpensePaymentId   String?
  createdById              String          @db.Uuid
  createdAt                DateTime        @default(now())

  account              SvAccount?         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  linkedClient         SvClient?          @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  linkedInvoice        SvInvoice?         @relation(fields: [linkedInvoiceId], references: [id], onDelete: SetNull)
  linkedPayment        SvPayment?         @relation(fields: [linkedPaymentId], references: [id], onDelete: SetNull)
  linkedExpenseInvoice SvExpenseInvoice?  @relation(fields: [linkedExpenseInvoiceId], references: [id], onDelete: SetNull)
  linkedExpensePayment SvExpensePayment?  @relation(fields: [linkedExpensePaymentId], references: [id], onDelete: SetNull)
  createdBy            User               @relation("SvCashMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([movedAt])
  @@index([direction, movedAt])
  @@index([reference])
  @@index([accountId, movedAt])
  @@index([accountId, countsTowardBalance])
  @@index([transferId])
  @@index([linkedExpenseInvoiceId])
  @@map("sv_cash_movements")
}

/// Facture interne / fournisseur (charges entreprise) — isolée des factures clients.
model SvExpenseInvoice {
  id             String            @id @default(cuid())
  category       SvExpenseCategory
  status         SvInvoiceStatus   @default(BROUILLON)
  vendorName     String
  vendorRef      String?
  number         String?
  issuedAt       DateTime?
  dueAt          DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  periodLabel    String?
  totalHt        Int               @default(0)
  totalVat       Int               @default(0)
  totalTtc       Int               @default(0)
  amountPaid     Int               @default(0)
  currency       String            @default("XOF")
  object         String?
  notes          String?
  sourceDocument String?
  gedDocumentId  String?
  createdById    String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  payments  SvExpensePayment[]
  movements SvCashMovement[]
  createdBy User               @relation("SvExpenseInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([sourceDocument])
  @@index([category, status])
  @@index([number])
  @@index([issuedAt])
  @@index([vendorName])
  @@map("sv_expense_invoices")
}

model SvExpensePayment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  reference String?
  note      String?
  createdAt DateTime @default(now())

  invoice   SvExpenseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  movements SvCashMovement[]

  @@index([invoiceId, paidAt])
  @@map("sv_expense_payments")
}

model SvStockItem {
  id            String    @id @default(cuid())
  code          String    @unique
  family        String
  subFamily     String?
  label         String
  unit          String
  quantity      Int       @default(0)
  location      String?
  observations  String?
  /// Soft archive — hors inventaire courant (ex. lignes Excel remplacées)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movements SvStockMovement[]

  @@index([family])
  @@index([archivedAt])
  @@map("sv_stock_items")
}

model SvStockMovement {
  id          String          @id @default(cuid())
  itemId      String
  movedAt     DateTime        @default(now())
  kind        SvStockMoveKind
  quantity    Int
  note        String?
  sourceRef   String?
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())

  item      SvStockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User        @relation("SvStockMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([itemId, movedAt])
  @@map("sv_stock_movements")
}
