// ERP MSK CREATION — Phase 0–3 (IAM, GED, Catalogue/CRM, Commercial)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  INVITE_PENDING
  MUST_CHANGE_PASSWORD
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OverrideEffect {
  GRANT
  DENY
}

enum ResetRequestStatus {
  PENDING
  DONE
  CANCELLED
}

enum DocVisibility {
  PRIVATE_SELF
  GROUP
  RH_ONLY
  DIRECTION
  COMPANY
  CUSTOM
}

enum DocStatus {
  ACTIVE
  ARCHIVED
  TRASH
}

enum AclRight {
  VIEW
  UPLOAD
  EDIT_META
  MANAGE_SHARE
}

enum SignatureKind {
  UPLOAD
}

enum SignatureStatus {
  DRAFT
  ACTIVE
  REVOKED
}

enum TemplateType {
  DEVIS
  FACTURE
}

enum CatalogPillar {
  IMAGE_MARQUE
  CONTENU_COMMUNICATION
  PRESENCE_DIGITALE
  CROISSANCE_ACQUISITION
  TRANSFORMATION_STRUCTURATION
}

enum CatalogBilling {
  ONE_SHOT
  MONTHLY
  PACKAGE
}

enum CrmSource {
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  TIKTOK
  GOOGLE_MAPS
  GOOGLE
  SNAPCHAT
  TERRAIN
  RECOMMANDATION
  EMAIL
  TELEPHONE
  AUTRE
}

enum CrmPipelineStage {
  NOUVEAU
  CONTACTE
  QUALIFICATION
  INTERESSE
  DEVIS_ENVOYE
  NEGOCIATION
  GAGNE
  PERDU
}

enum CrmActivityType {
  APPEL
  WHATSAPP
  INSTAGRAM
  LINKEDIN
  EMAIL
  RDV
  NOTE
  AUTRE
}

enum CrmTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum CrmLossReason {
  BUDGET
  CONCURRENT
  TIMING
  NO_SHOW
  AUTRE
}

enum ComDocRegime {
  ML
  FR
}

enum ComDocKind {
  DEVIS
  FACTURE
}

enum ComQuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  ANNULE
}

enum ComInvoiceStatus {
  BROUILLON
  EMISE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum ComPaymentMethod {
  ESPECES
  VIREMENT
  MOBILE_MONEY
  AUTRE
}

/// Singleton single-tenant MSK (id fixe = "msk")
model OrganizationSettings {
  id               String   @id @default("msk")
  legalName        String   @default("MSK CREATION")
  tradeName        String   @default("MSK CREATION")
  defaultCurrency  String   @default("XOF")
  defaultVatRate   Decimal  @default(18.00) @db.Decimal(5, 2)
  frVatRate        Decimal  @default(20.00) @db.Decimal(5, 2)
  countryCode      String   @default("ML")
  timezone         String   @default("Africa/Bamako")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("organization_settings")
}

/// Profil applicatif lié à auth.users (id = UUID Supabase Auth)
model User {
  id                 String     @id @db.Uuid
  email              String     @unique
  firstName          String
  lastName           String
  phone              String?
  status             UserStatus @default(INVITE_PENDING)
  isSuperAdmin       Boolean    @default(false)
  mustChangePassword Boolean    @default(true)
  invitedAt          DateTime?
  activatedAt        DateTime?
  lastLoginAt        DateTime?
  suspendedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  groupMembers   GroupMember[]
  userPacks      UserPack[]
  overrides      UserPermissionOverride[]
  auditLogs      AuditLog[]              @relation("AuditActor")
  resetRequests  PasswordResetRequest[]  @relation("ResetSubject")
  resetsResolved PasswordResetRequest[]  @relation("ResetResolver")
  foldersCreated DocumentFolder[]        @relation("FolderCreator")
  docsCreated    Document[]              @relation("DocCreator")
  documentAcls   DocumentAcl[]
  signatures     SignatureAsset[]
  orgNodes       OrgNode[]
  crmOrgsOwned   CrmOrganization[] @relation("CrmOrgOwner")
  crmOrgsCreated CrmOrganization[] @relation("CrmOrgCreator")
  crmDealsOwned CrmOpportunity[]  @relation("CrmDealOwner")
  crmDealsCreated CrmOpportunity[] @relation("CrmDealCreator")
  crmActivities CrmActivity[]     @relation("CrmActivityActor")
  crmTasksAssigned CrmTask[]      @relation("CrmTaskAssignee")
  crmTasksCreated  CrmTask[]      @relation("CrmTaskCreator")
  comClientsOwned  ComClient[]     @relation("ComClientOwner")
  comClientsCreated ComClient[]    @relation("ComClientCreator")
  comQuotesOwned   ComQuote[]      @relation("ComQuoteOwner")
  comQuotesCreated ComQuote[]      @relation("ComQuoteCreator")
  comInvoicesOwned ComInvoice[]    @relation("ComInvoiceOwner")
  comInvoicesCreated ComInvoice[]  @relation("ComInvoiceCreator")
  comPaymentsRecorded ComPayment[] @relation("ComPaymentRecorder")

  @@index([status])
  @@map("users")
}

model Group {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String?
  defaultPackId String?
  sortOrder     Int     @default(0)

  defaultPack PermissionPack? @relation("GroupDefaultPack", fields: [defaultPackId], references: [id], onDelete: SetNull)
  members     GroupMember[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  domain      String
  description String?

  packItems PackPermission[]
  overrides UserPermissionOverride[]

  @@index([domain])
  @@map("permissions")
}

model PermissionPack {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)

  permissions   PackPermission[]
  userPacks     UserPack[]
  groupsDefault Group[]          @relation("GroupDefaultPack")

  @@map("permission_packs")
}

model PackPermission {
  packId       String
  permissionId String

  pack       PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([packId, permissionId])
  @@map("pack_permissions")
}

model UserPack {
  userId    String   @db.Uuid
  packId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([userId, packId])
  @@index([packId])
  @@map("user_packs")
}

model UserPermissionOverride {
  id           String         @id @default(cuid())
  userId       String         @db.Uuid
  permissionId String
  effect       OverrideEffect
  reason       String?
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PasswordResetRequest {
  id                String             @id @default(cuid())
  userId            String             @db.Uuid
  requesterEmail    String?
  status            ResetRequestStatus @default(PENDING)
  note              String?
  createdAt         DateTime           @default(now())
  resolvedAt        DateTime?
  resolvedById      String?            @db.Uuid

  user       User  @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ResetResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("password_reset_requests")
}

// ─── Phase 1 GED ───────────────────────────────────────────────

model DocumentFolder {
  id         String        @id @default(cuid())
  parentId   String?
  name       String
  code       String
  path       String
  year       Int?
  visibility DocVisibility @default(COMPANY)
  createdById String?      @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]
  acls      DocumentAcl[]
  createdBy User?            @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([path])
  @@index([parentId])
  @@index([year])
  @@index([code])
  @@map("document_folders")
}

model Document {
  id           String        @id @default(cuid())
  folderId     String
  storagePath  String
  originalName String
  mime         String
  size         Int
  checksum     String?
  version      Int           @default(1)
  status       DocStatus     @default(ACTIVE)
  visibility   DocVisibility @default(COMPANY)
  createdById  String?       @db.Uuid
  softDeletedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  folder    DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("DocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  links     DocumentLink[]
  acls      DocumentAcl[]

  @@index([folderId])
  @@index([status])
  @@index([softDeletedAt])
  @@map("documents")
}

model DocumentLink {
  id         String @id @default(cuid())
  documentId String
  entityType String
  entityId   String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

model DocumentAcl {
  id         String    @id @default(cuid())
  folderId   String?
  documentId String?
  userId     String    @db.Uuid
  right      AclRight  @default(VIEW)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([documentId])
  @@index([userId])
  @@map("document_acls")
}

model BrandAsset {
  id        String   @id @default(cuid())
  kind      String   @unique
  label     String
  publicPath String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_assets")
}

model SignatureAsset {
  id              String          @id @default(cuid())
  ownerUserId     String?         @db.Uuid
  orgOwned        Boolean         @default(false)
  kind            SignatureKind   @default(UPLOAD)
  label           String
  storageOriginal String
  /** PNG fond transparent après pipeline de nettoyage (null = pas encore traité). */
  storageCleaned  String?
  mime            String
  status          SignatureStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([status])
  @@map("signature_assets")
}

model OrgNode {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  title     String
  fullName  String
  email     String?
  photoPath String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   OrgNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgNode[] @relation("OrgTree")

  @@index([parentId])
  @@index([sortOrder])
  @@map("org_nodes")
}

model DocumentTemplate {
  id            String       @id @default(cuid())
  type          TemplateType
  code          String       @unique
  name          String
  version       Int          @default(1)
  structureJson Json         @default("{}")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@map("document_templates")
}

/// Offre catalogue MSK (5 piliers)
model CatalogOffer {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  description   String?
  pillar        CatalogPillar
  billing       CatalogBilling @default(ONE_SHOT)
  priceXof      Int?
  priceEurHint  Int?
  vatEligible   Boolean        @default(true)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  opportunities CrmOpportunity[]
  quoteLines    ComQuoteLine[]
  invoiceLines  ComInvoiceLine[]

  @@index([pillar, active])
  @@map("catalog_offers")
}

model CrmOrganization {
  id            String     @id @default(cuid())
  name          String
  normalizedName String
  sector        String?
  city          String?
  country       String     @default("ML")
  website       String?
  source        CrmSource?
  notes         String?
  ownerId       String     @db.Uuid
  createdById   String     @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner       User             @relation("CrmOrgOwner", fields: [ownerId], references: [id])
  createdBy   User             @relation("CrmOrgCreator", fields: [createdById], references: [id])
  contacts    CrmContact[]
  opportunities CrmOpportunity[]
  activities  CrmActivity[]
  tasks       CrmTask[]
  comClients  ComClient[]

  @@index([ownerId])
  @@index([normalizedName])
  @@map("crm_organizations")
}

model CrmContact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  jobTitle       String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization CrmOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("crm_contacts")
}

model CrmOpportunity {
  id              String           @id @default(cuid())
  organizationId  String
  title           String
  stage           CrmPipelineStage @default(NOUVEAU)
  source          CrmSource?
  offerLabel      String?
  catalogOfferId  String?
  budgetXof       Int?
  probability     Int?             // 0..100
  expectedCloseAt DateTime?
  lossReason      CrmLossReason?
  lossNote        String?
  ownerId         String           @db.Uuid
  createdById     String           @db.Uuid
  lastActivityAt  DateTime?
  nextAction      String?
  followUpAt      DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization CrmOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer?   @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)
  owner        User            @relation("CrmDealOwner", fields: [ownerId], references: [id])
  createdBy    User            @relation("CrmDealCreator", fields: [createdById], references: [id])
  activities   CrmActivity[]
  tasks        CrmTask[]
  comClients   ComClient[]
  comQuotes    ComQuote[]

  @@index([ownerId, stage])
  @@index([organizationId])
  @@index([followUpAt])
  @@map("crm_opportunities")
}

model CrmActivity {
  id             String         @id @default(cuid())
  organizationId String?
  opportunityId  String?
  type           CrmActivityType
  summary        String
  body           String?
  occurredAt     DateTime       @default(now())
  actorId        String         @db.Uuid
  createdAt      DateTime       @default(now())

  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor        User             @relation("CrmActivityActor", fields: [actorId], references: [id])

  @@index([opportunityId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("crm_activities")
}

model CrmTask {
  id             String        @id @default(cuid())
  organizationId String?
  opportunityId  String?
  title          String
  dueAt          DateTime
  status         CrmTaskStatus @default(OPEN)
  assigneeId     String        @db.Uuid
  createdById    String        @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee     User             @relation("CrmTaskAssignee", fields: [assigneeId], references: [id])
  createdBy    User             @relation("CrmTaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, status, dueAt])
  @@index([dueAt])
  @@map("crm_tasks")
}

model CrmScript {
  id        String    @id @default(cuid())
  code      String    @unique
  channel   CrmSource
  title     String
  body      String
  tips      String?
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([channel, active])
  @@map("crm_scripts")
}

model ComNumberSequence {
  id        String     @id @default(cuid())
  kind      ComDocKind
  year      Int
  lastValue Int        @default(0)
  updatedAt DateTime   @updatedAt

  @@unique([kind, year])
  @@map("com_number_sequences")
}

model ComClient {
  id                   String   @id @default(cuid())
  name                 String
  normalizedName       String
  contactName          String?
  email                String?
  phone                String?
  address              String?
  city                 String?
  country              String   @default("ML")
  notes                String?
  includeTravelDefault Boolean  @default(false)
  crmOrganizationId    String?
  sourceOpportunityId  String?
  ownerId              String   @db.Uuid
  createdById          String   @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  crmOrganization CrmOrganization? @relation(fields: [crmOrganizationId], references: [id], onDelete: SetNull)
  sourceOpportunity CrmOpportunity? @relation(fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  owner     User @relation("ComClientOwner", fields: [ownerId], references: [id])
  createdBy User @relation("ComClientCreator", fields: [createdById], references: [id])
  quotes    ComQuote[]
  invoices  ComInvoice[]

  @@index([ownerId])
  @@index([normalizedName])
  @@index([crmOrganizationId])
  @@map("com_clients")
}

model ComQuote {
  id              String         @id @default(cuid())
  number          String         @unique
  status          ComQuoteStatus @default(BROUILLON)
  regime          ComDocRegime   @default(ML)
  currency        String         @default("XOF")
  vatEnabled      Boolean        @default(true)
  vatRate         Int            @default(18)
  promoEnabled    Boolean        @default(false)
  promoPercent    Int?
  includeTravel   Boolean        @default(false)
  object          String?
  missionNote     String?
  validUntil      DateTime?
  totalHt         Int            @default(0)
  totalVat        Int            @default(0)
  totalTtc        Int            @default(0)
  clientId        String
  opportunityId   String?
  ownerId         String         @db.Uuid
  createdById     String         @db.Uuid
  gedDocumentId   String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client      ComClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User            @relation("ComQuoteOwner", fields: [ownerId], references: [id])
  createdBy   User            @relation("ComQuoteCreator", fields: [createdById], references: [id])
  lines       ComQuoteLine[]
  invoices    ComInvoice[]

  @@index([clientId])
  @@index([ownerId, status])
  @@index([opportunityId])
  @@map("com_quotes")
}

model ComQuoteLine {
  id             String  @id @default(cuid())
  quoteId        String
  sortOrder      Int     @default(0)
  label          String
  qty            Int     @default(1)
  unitPrice      Int
  catalogOfferId String?
  isTravel       Boolean @default(false)

  quote        ComQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer? @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("com_quote_lines")
}

model ComInvoice {
  id            String           @id @default(cuid())
  number        String           @unique
  status        ComInvoiceStatus @default(BROUILLON)
  regime        ComDocRegime     @default(ML)
  currency      String           @default("XOF")
  vatEnabled    Boolean          @default(true)
  vatRate       Int              @default(18)
  object        String?
  totalHt       Int              @default(0)
  totalVat      Int              @default(0)
  totalTtc      Int              @default(0)
  amountPaid    Int              @default(0)
  clientId      String
  quoteId       String?
  ownerId       String           @db.Uuid
  createdById   String           @db.Uuid
  gedDocumentId String?
  issuedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  client    ComClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote     ComQuote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  owner     User           @relation("ComInvoiceOwner", fields: [ownerId], references: [id])
  createdBy User           @relation("ComInvoiceCreator", fields: [createdById], references: [id])
  lines     ComInvoiceLine[]
  payments  ComPayment[]

  @@index([clientId])
  @@index([ownerId, status])
  @@index([quoteId])
  @@map("com_invoices")
}

model ComInvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  sortOrder      Int     @default(0)
  label          String
  qty            Int     @default(1)
  unitPrice      Int
  catalogOfferId String?
  isTravel       Boolean @default(false)

  invoice      ComInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer? @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("com_invoice_lines")
}

model ComPayment {
  id          String           @id @default(cuid())
  invoiceId   String
  amount      Int
  method      ComPaymentMethod @default(VIREMENT)
  paidAt      DateTime         @default(now())
  note        String?
  recordedById String          @db.Uuid
  createdAt   DateTime         @default(now())

  invoice    ComInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("ComPaymentRecorder", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@map("com_payments")
}
