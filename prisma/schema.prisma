}

model RhPayslip {
  id                  String         @id @default(cuid())
  periodId            String
  employeeId          String
  contractId          String?
  status              RhPayslipStatus @default(DRAFT)
  baseSalaryXof       Int
  primesXof           Int            @default(0)
  brutXof             Int
  employeeDeductXof   Int            @default(0)
  employerChargesXof  Int            @default(0)
  netXof              Int
  gedDocumentId       String?
  cptEntryId          String?
  paidAt              DateTime?
  paymentRef          String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  period   RhPayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee RhEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    RhPayslipLine[]
  inpsLine RhInpsLine?

  @@unique([periodId, employeeId])
  @@index([employeeId, status])
  @@map("rh_payslips")
}

model RhPayslipLine {
  id         String  @id @default(cuid())
  payslipId  String
  code       String
  label      String
  kind       String
  rate       Decimal? @db.Decimal(8, 6)
  amountXof  Int
  sortOrder  Int     @default(0)

  payslip RhPayslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("rh_payslip_lines")
}

model RhInpsLine {
  id                       String           @id @default(cuid())
  periodId                 String
  employeeId               String
  payslipId                String?          @unique
  baseAmountXof            Int
  employeeContributionXof  Int
  employerContributionXof  Int
  status                   RhInpsLineStatus @default(DRAFT)
  paymentRef               String?
  declaredAt               DateTime?
  paidAt                   DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  period   RhPayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee RhEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslip  RhPayslip?      @relation(fields: [payslipId], references: [id], onDelete: SetNull)

