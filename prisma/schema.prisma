}

model RhProfileChangeLine {
  id        String @id @default(cuid())
  requestId String
  fieldKey  String
  oldValue  String?
  newValue  String

  request RhProfileChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("rh_profile_change_lines")
}

