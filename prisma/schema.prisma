// ERP MSK CREATION — Phase 0–4 + 6 (IAM, GED, Catalogue/CRM, Commercial, RH, Comptabilité)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  INVITE_PENDING
  MUST_CHANGE_PASSWORD
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OverrideEffect {
  GRANT
  DENY
}

enum ResetRequestStatus {
  PENDING
  DONE
  CANCELLED
}

enum DocVisibility {
  PRIVATE_SELF
  GROUP
  RH_ONLY
  DIRECTION
  COMPANY
  CUSTOM
}

enum DocStatus {
  ACTIVE
  ARCHIVED
  TRASH
}

enum AclRight {
  VIEW
  UPLOAD
  EDIT_META
  MANAGE_SHARE
}

enum SignatureKind {
  UPLOAD
}

enum SignatureStatus {
  DRAFT
  ACTIVE
  REVOKED
}

enum TemplateType {
  DEVIS
  FACTURE
  CONTRAT_TRAVAIL
  CONTRAT_STAGE
  CONTRAT_PRESTA
  ATTESTATION_STAGE
  REGLEMENT_INTERIEUR
  SOLDE_TOUT_COMPTE
  FICHE_PAIE
}

enum CatalogPillar {
  IMAGE_MARQUE
  CONTENU_COMMUNICATION
  PRESENCE_DIGITALE
  CROISSANCE_ACQUISITION
  TRANSFORMATION_STRUCTURATION
}

enum CatalogBilling {
  ONE_SHOT
  MONTHLY
  PACKAGE
}

enum CrmSource {
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  TIKTOK
  GOOGLE_MAPS
  GOOGLE
  SNAPCHAT
  TERRAIN
  RECOMMANDATION
  EMAIL
  TELEPHONE
  AUTRE
}

enum CrmPipelineStage {
  NOUVEAU
  CONTACTE
  QUALIFICATION
  INTERESSE
  DEVIS_ENVOYE
  NEGOCIATION
  GAGNE
  PERDU
}

enum CrmActivityType {
  APPEL
  WHATSAPP
  INSTAGRAM
  LINKEDIN
  EMAIL
  RDV
  NOTE
  AUTRE
}

enum CrmTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum CrmLossReason {
  BUDGET
  CONCURRENT
  TIMING
  NO_SHOW
  AUTRE
}

enum ComDocRegime {
  ML
  FR
}

enum ComDocKind {
  DEVIS
  FACTURE
}

enum ComQuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  ANNULE
}

enum ComInvoiceStatus {
  BROUILLON
  EMISE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum ComPaymentMethod {
  ESPECES
  VIREMENT
  MOBILE_MONEY
  AUTRE
}

/// Singleton single-tenant MSK (id fixe = "msk")
model OrganizationSettings {
  id               String   @id @default("msk")
  legalName        String   @default("MSK CREATION")
  tradeName        String   @default("MSK CREATION")
  defaultCurrency  String   @default("XOF")
  defaultVatRate   Decimal  @default(18.00) @db.Decimal(5, 2)
  frVatRate        Decimal  @default(20.00) @db.Decimal(5, 2)
  countryCode      String   @default("ML")
  timezone         String   @default("Africa/Bamako")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("organization_settings")
}

/// Profil applicatif lié à auth.users (id = UUID Supabase Auth)
model User {
  id                 String     @id @db.Uuid
  email              String     @unique
  firstName          String
  lastName           String
  phone              String?
  status             UserStatus @default(INVITE_PENDING)
  isSuperAdmin       Boolean    @default(false)
  mustChangePassword Boolean    @default(true)
  invitedAt          DateTime?
  activatedAt        DateTime?
  lastLoginAt        DateTime?
  suspendedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  groupMembers   GroupMember[]
  userPacks      UserPack[]
  overrides      UserPermissionOverride[]
  auditLogs      AuditLog[]              @relation("AuditActor")
  resetRequests  PasswordResetRequest[]  @relation("ResetSubject")
  resetsResolved PasswordResetRequest[]  @relation("ResetResolver")
  foldersCreated DocumentFolder[]        @relation("FolderCreator")
  docsCreated    Document[]              @relation("DocCreator")
  documentAcls   DocumentAcl[]
  signatures     SignatureAsset[]
  orgNodes       OrgNode[]
  crmOrgsOwned   CrmOrganization[] @relation("CrmOrgOwner")
  crmOrgsCreated CrmOrganization[] @relation("CrmOrgCreator")
  crmDealsOwned CrmOpportunity[]  @relation("CrmDealOwner")
  crmDealsCreated CrmOpportunity[] @relation("CrmDealCreator")
  crmActivities CrmActivity[]     @relation("CrmActivityActor")
  crmTasksAssigned CrmTask[]      @relation("CrmTaskAssignee")
  crmTasksCreated  CrmTask[]      @relation("CrmTaskCreator")
  crmWeeklyReports CrmWeeklyReport[] @relation("CrmWeeklyReportAuthor")
  crmWeeklyGoals    CrmWeeklyGoal[]   @relation("CrmWeeklyGoalUser")
  comClientsOwned  ComClient[]     @relation("ComClientOwner")
  comClientsCreated ComClient[]    @relation("ComClientCreator")
  comQuotesOwned   ComQuote[]      @relation("ComQuoteOwner")
  comQuotesCreated ComQuote[]      @relation("ComQuoteCreator")
  comInvoicesOwned ComInvoice[]    @relation("ComInvoiceOwner")
  comInvoicesCreated ComInvoice[]  @relation("ComInvoiceCreator")
  comPaymentsRecorded ComPayment[] @relation("ComPaymentRecorder")
  cptEntriesCreated   CptEntry[]     @relation("CptEntryCreator")
  cptEntriesValidated CptEntry[]     @relation("CptEntryValidator")
  cptBankTxnsCreated  CptBankTxn[]   @relation("CptBankTxnCreator")
  budLinesCreated     BudLine[]      @relation("BudLineCreator")
  rhEmployee          RhEmployee?    @relation("RhEmployeeUser")
  rhLeavesRequested   RhLeaveRequest[] @relation("RhLeaveRequester")
  rhLeavesValidated   RhLeaveRequest[] @relation("RhLeaveValidator")
  rhAbsencesDeclared  RhAbsence[]      @relation("RhAbsenceDeclarer")
  rhAbsencesReviewed  RhAbsence[]      @relation("RhAbsenceReviewer")
  rhTimesheetsOwned   RhTimesheet[]    @relation("RhTimesheetOwner")
  rhTimesheetsValidated RhTimesheet[]  @relation("RhTimesheetValidator")
  rhPayrollOpened     RhPayrollPeriod[] @relation("RhPayrollOpener")
  rhPayrollApproved   RhPayrollPeriod[] @relation("RhPayrollApprover")
  stkArticlesCreated  StkArticle[]      @relation("StkArticleCreator")
  stkMovementsCreated StkMovement[]     @relation("StkMovementCreator")
  stkPurchasesCreated StkPurchase[]     @relation("StkPurchaseCreator")
  patAssetsCreated    PatAsset[]        @relation("PatAssetCreator")
  patAssetsAssigned   PatAsset[]        @relation("PatAssetAssignee")
  prjProjectsOwned    PrjProject[]      @relation("PrjProjectOwner")
  prjMemberships      PrjMember[]
  prjExpensesCreated  PrjExpense[]      @relation("PrjExpenseCreator")
  prjExpensesReviewed PrjExpense[]      @relation("PrjExpenseReviewer")
  opsTicketsCreated   OpsTicket[]       @relation("OpsTicketCreator")
  opsTicketsAssigned  OpsTicket[]       @relation("OpsTicketAssignee")

  @@index([status])
  @@map("users")
}

model Group {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String?
  defaultPackId String?
  sortOrder     Int     @default(0)

  defaultPack PermissionPack? @relation("GroupDefaultPack", fields: [defaultPackId], references: [id], onDelete: SetNull)
  members     GroupMember[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  domain      String
  description String?

  packItems PackPermission[]
  overrides UserPermissionOverride[]

  @@index([domain])
  @@map("permissions")
}

model PermissionPack {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)

  permissions   PackPermission[]
  userPacks     UserPack[]
  groupsDefault Group[]          @relation("GroupDefaultPack")

  @@map("permission_packs")
}

model PackPermission {
  packId       String
  permissionId String

  pack       PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([packId, permissionId])
  @@map("pack_permissions")
}

model UserPack {
  userId    String   @db.Uuid
  packId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([userId, packId])
  @@index([packId])
  @@map("user_packs")
}

model UserPermissionOverride {
  id           String         @id @default(cuid())
  userId       String         @db.Uuid
  permissionId String
  effect       OverrideEffect
  reason       String?
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PasswordResetRequest {
  id                String             @id @default(cuid())
  userId            String             @db.Uuid
  requesterEmail    String?
  status            ResetRequestStatus @default(PENDING)
  note              String?
  createdAt         DateTime           @default(now())
  resolvedAt        DateTime?
  resolvedById      String?            @db.Uuid

  user       User  @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ResetResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("password_reset_requests")
}

// ─── Phase 1 GED ───────────────────────────────────────────────

model DocumentFolder {
  id         String        @id @default(cuid())
  parentId   String?
  name       String
  code       String
  path       String
  year       Int?
  visibility DocVisibility @default(COMPANY)
  createdById String?      @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]
  acls      DocumentAcl[]
  createdBy User?            @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([path])
  @@index([parentId])
  @@index([year])
  @@index([code])
  @@map("document_folders")
}

model Document {
  id           String        @id @default(cuid())
  folderId     String
  storagePath  String
  originalName String
  mime         String
  size         Int
  checksum     String?
  version      Int           @default(1)
  status       DocStatus     @default(ACTIVE)
  visibility   DocVisibility @default(COMPANY)
  createdById  String?       @db.Uuid
  softDeletedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  folder    DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("DocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  links     DocumentLink[]
  acls      DocumentAcl[]

  @@index([folderId])
  @@index([status])
  @@index([softDeletedAt])
  @@map("documents")
}

model DocumentLink {
  id         String @id @default(cuid())
  documentId String
  entityType String
  entityId   String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

model DocumentAcl {
  id         String    @id @default(cuid())
  folderId   String?
  documentId String?
  userId     String    @db.Uuid
  right      AclRight  @default(VIEW)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([documentId])
  @@index([userId])
  @@map("document_acls")
}

model BrandAsset {
  id        String   @id @default(cuid())
  kind      String   @unique
  label     String
  publicPath String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_assets")
}

model SignatureAsset {
  id              String          @id @default(cuid())
  ownerUserId     String?         @db.Uuid
  orgOwned        Boolean         @default(false)
  kind            SignatureKind   @default(UPLOAD)
  label           String
  storageOriginal String
  /** PNG fond transparent après pipeline de nettoyage (null = pas encore traité). */
  storageCleaned  String?
  mime            String
  status          SignatureStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([status])
  @@map("signature_assets")
}

model OrgNode {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  title     String
  fullName  String
  email     String?
  photoPath String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   OrgNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgNode[] @relation("OrgTree")

  @@index([parentId])
  @@index([sortOrder])
  @@map("org_nodes")
}

model DocumentTemplate {
  id            String       @id @default(cuid())
  type          TemplateType
  code          String       @unique
  name          String
  version       Int          @default(1)
  structureJson Json         @default("{}")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@map("document_templates")
}

/// Offre catalogue MSK (5 piliers)
model CatalogOffer {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  description   String?
  pillar        CatalogPillar
  billing       CatalogBilling @default(ONE_SHOT)
  priceXof      Int?
  /// Plancher commercial — prix unitaire devis ne peut pas descendre en dessous.
  floorPriceXof Int?
  priceEurHint  Int?
  vatEligible   Boolean        @default(true)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  /// Schéma UI options (RS / WEB / ECOM…) — JSON OfferOptionSchema.
  optionSchema  Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  opportunities CrmOpportunity[]
  opportunityOffers CrmOpportunityOffer[]
  quoteLines    ComQuoteLine[]
  invoiceLines  ComInvoiceLine[]

  @@index([pillar, active])
  @@map("catalog_offers")
}

model CrmOrganization {
  id            String     @id @default(cuid())
  name          String
  normalizedName String
  sector        String?
  city          String?
  country       String     @default("ML")
  website       String?
  source        CrmSource?
  notes         String?
  ownerId       String     @db.Uuid
  createdById   String     @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner       User             @relation("CrmOrgOwner", fields: [ownerId], references: [id])
  createdBy   User             @relation("CrmOrgCreator", fields: [createdById], references: [id])
  contacts    CrmContact[]
  opportunities CrmOpportunity[]
  activities  CrmActivity[]
  tasks       CrmTask[]
  comClients  ComClient[]

  @@index([ownerId])
  @@index([normalizedName])
  @@map("crm_organizations")
}

model CrmContact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  jobTitle       String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization CrmOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("crm_contacts")
}

model CrmOpportunity {
  id              String           @id @default(cuid())
  organizationId  String
  title           String
  stage           CrmPipelineStage @default(NOUVEAU)
  source          CrmSource?
  offerLabel      String?
  catalogOfferId  String?
  budgetXof       Int?
  probability     Int?             // 0..100
  expectedCloseAt DateTime?
  lossReason      CrmLossReason?
  lossNote        String?
  ownerId         String           @db.Uuid
  createdById     String           @db.Uuid
  lastActivityAt  DateTime?
  nextAction      String?
  followUpAt      DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  /// Entrée en statut Intéressé — SLA devis 24h (GUIDE).
  interestedAt    DateTime?        @map("interested_at")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization CrmOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer?   @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)
  owner        User            @relation("CrmDealOwner", fields: [ownerId], references: [id])
  createdBy    User            @relation("CrmDealCreator", fields: [createdById], references: [id])
  activities   CrmActivity[]
  tasks        CrmTask[]
  opportunityOffers CrmOpportunityOffer[]
  comClients   ComClient[]
  comQuotes    ComQuote[]

  @@index([ownerId, stage])
  @@index([organizationId])
  @@index([followUpAt])
  @@map("crm_opportunities")
}

/// Offres proposées à un prospect (N:N) + config options.
model CrmOpportunityOffer {
  id             String   @id @default(cuid())
  opportunityId  String
  catalogOfferId String
  config         Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity  CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer   @relation(fields: [catalogOfferId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, catalogOfferId])
  @@index([opportunityId])
  @@map("crm_opportunity_offers")
}

model CrmActivity {
  id             String         @id @default(cuid())
  organizationId String?
  opportunityId  String?
  type           CrmActivityType
  summary        String
  body           String?
  occurredAt     DateTime       @default(now())
  actorId        String         @db.Uuid
  createdAt      DateTime       @default(now())

  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor        User             @relation("CrmActivityActor", fields: [actorId], references: [id])

  @@index([opportunityId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("crm_activities")
}

model CrmTask {
  id             String        @id @default(cuid())
  organizationId String?
  opportunityId  String?
  title          String
  dueAt          DateTime
  status         CrmTaskStatus @default(OPEN)
  assigneeId     String        @db.Uuid
  createdById    String        @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee     User             @relation("CrmTaskAssignee", fields: [assigneeId], references: [id])
  createdBy    User             @relation("CrmTaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, status, dueAt])
  @@index([dueAt])
  @@map("crm_tasks")
}

model CrmScript {
  id        String    @id @default(cuid())
  code      String    @unique
  channel   CrmSource
  title     String
  body      String
  tips      String?
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([channel, active])
  @@map("crm_scripts")
}

/// Objectifs hebdo paramétrables (collab ou équipe).
model CrmWeeklyGoal {
  id        String   @id @default(cuid())
  /// USER = un collab ; TEAM = objectif pôle (userId null).
  scope     String
  userId    String?  @db.Uuid
  /// NEW_PROSPECTS | FIRST_CONTACTS | MEETINGS | FOLLOW_UPS
  metric    String
  target    Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User? @relation("CrmWeeklyGoalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, userId, metric])
  @@index([scope, metric])
  @@map("crm_weekly_goals")
}

/// Rapport de semaine (vendredi) — chiffres préremplis + qualitatif.
model CrmWeeklyReport {
  id              String   @id @default(cuid())
  authorId        String   @db.Uuid
  /// Lundi 00:00 de la semaine concernée (UTC date).
  weekStart       DateTime @db.Date
  newProspects    Int      @default(0)
  firstContacts   Int      @default(0)
  replies         Int      @default(0)
  inDiscussion    Int      @default(0)
  qualified       Int      @default(0)
  meetings        Int      @default(0)
  followUpsDone   Int      @default(0)
  difficulty      String?
  needs           String?
  scriptsFeedback String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author User @relation("CrmWeeklyReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, weekStart])
  @@index([weekStart])
  @@map("crm_weekly_reports")
}

model ComNumberSequence {
  id        String     @id @default(cuid())
  kind      ComDocKind
  year      Int
  lastValue Int        @default(0)
  updatedAt DateTime   @updatedAt

  @@unique([kind, year])
  @@map("com_number_sequences")
}

model ComClient {
  id                   String   @id @default(cuid())
  name                 String
  normalizedName       String
  /// Code dossier GED unique sous `03_CLIENTS` (évite collision nom → slug).
  gedFolderCode        String   @unique
  contactName          String?
  email                String?
  phone                String?
  address              String?
  city                 String?
  country              String   @default("ML")
  notes                String?
  includeTravelDefault Boolean  @default(false)
  crmOrganizationId    String?
  sourceOpportunityId  String?
  ownerId              String   @db.Uuid
  createdById          String   @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  crmOrganization CrmOrganization? @relation(fields: [crmOrganizationId], references: [id], onDelete: SetNull)
  sourceOpportunity CrmOpportunity? @relation(fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  owner     User @relation("ComClientOwner", fields: [ownerId], references: [id])
  createdBy User @relation("ComClientCreator", fields: [createdById], references: [id])
  quotes    ComQuote[]
  invoices  ComInvoice[]

  @@index([ownerId])
  @@index([normalizedName])
  @@index([crmOrganizationId])
  @@map("com_clients")
}

model ComQuote {
  id              String         @id @default(cuid())
  number          String         @unique
  status          ComQuoteStatus @default(BROUILLON)
  regime          ComDocRegime   @default(ML)
  currency        String         @default("XOF")
  vatEnabled      Boolean        @default(true)
  vatRate         Int            @default(18)
  promoEnabled    Boolean        @default(false)
  promoPercent    Int?
  includeTravel   Boolean        @default(false)
  object          String?
  missionNote     String?
  validUntil      DateTime?
  totalHt         Int            @default(0)
  totalVat        Int            @default(0)
  totalTtc        Int            @default(0)
  clientId        String
  opportunityId   String?
  ownerId         String         @db.Uuid
  createdById     String         @db.Uuid
  gedDocumentId   String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client      ComClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User            @relation("ComQuoteOwner", fields: [ownerId], references: [id])
  createdBy   User            @relation("ComQuoteCreator", fields: [createdById], references: [id])
  lines       ComQuoteLine[]
  invoices    ComInvoice[]

  @@index([clientId])
  @@index([ownerId, status])
  /// Un seul devis lié par prospect (NULL autorisé plusieurs fois en PG).
  @@unique([opportunityId])
  @@map("com_quotes")
}

model ComQuoteLine {
  id             String  @id @default(cuid())
  quoteId        String
  sortOrder      Int     @default(0)
  label          String
  qty            Int     @default(1)
  unitPrice      Int
  catalogOfferId String?
  isTravel       Boolean @default(false)

  quote        ComQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer? @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("com_quote_lines")
}

model ComInvoice {
  id            String           @id @default(cuid())
  number        String           @unique
  status        ComInvoiceStatus @default(BROUILLON)
  regime        ComDocRegime     @default(ML)
  currency      String           @default("XOF")
  vatEnabled    Boolean          @default(true)
  vatRate       Int              @default(18)
  object        String?
  totalHt       Int              @default(0)
  totalVat      Int              @default(0)
  totalTtc      Int              @default(0)
  amountPaid    Int              @default(0)
  clientId      String
  quoteId       String?
  ownerId       String           @db.Uuid
  createdById   String           @db.Uuid
  gedDocumentId String?
  issuedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  client    ComClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote     ComQuote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  owner     User           @relation("ComInvoiceOwner", fields: [ownerId], references: [id])
  createdBy User           @relation("ComInvoiceCreator", fields: [createdById], references: [id])
  lines     ComInvoiceLine[]
  payments  ComPayment[]

  @@index([clientId])
  @@index([ownerId, status])
  @@unique([quoteId])
  @@map("com_invoices")
}

model ComInvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  sortOrder      Int     @default(0)
  label          String
  qty            Int     @default(1)
  unitPrice      Int
  catalogOfferId String?
  isTravel       Boolean @default(false)

  invoice      ComInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer? @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("com_invoice_lines")
}

model ComPayment {
  id          String           @id @default(cuid())
  invoiceId   String
  amount      Int
  method      ComPaymentMethod @default(VIREMENT)
  paidAt      DateTime         @default(now())
  note        String?
  recordedById String          @db.Uuid
  createdAt   DateTime         @default(now())

  invoice    ComInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("ComPaymentRecorder", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@map("com_payments")
}

// ─── Phase 6 — Comptabilité SYSCOHADA + banques + budget ───

enum CptAccountNature {
  ASSET
  LIABILITY
  EQUITY
  EXPENSE
  INCOME
}

enum CptExerciseStatus {
  OPEN
  CLOSED
}

enum CptPeriodStatus {
  OPEN
  CLOSED
}

enum CptEntryStatus {
  DRAFT
  VALIDATED
}

enum BudNature {
  CAPEX
  OPEX
}

enum BudPatenteStatus {
  PENDING
  PAID
  OVERDUE
}

/// Plan de comptes SYSCOHADA (minimal PME, extensible)
model CptAccount {
  id         String           @id @default(cuid())
  code       String           @unique
  label      String
  classNum   Int
  nature     CptAccountNature
  isPostable Boolean          @default(true)
  active     Boolean          @default(true)
  parentId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  parent   CptAccount?  @relation("CptAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CptAccount[] @relation("CptAccountTree")
  lines    CptEntryLine[]
  banks    CptBankAccount[]

  @@index([classNum, code])
  @@index([active, isPostable])
  @@map("cpt_accounts")
}

model CptJournal {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CptEntry[]

  @@map("cpt_journals")
}

model CptExercise {
  id        String            @id @default(cuid())
  year      Int               @unique
  status    CptExerciseStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  periods CptPeriod[]

  @@map("cpt_exercises")
}

model CptPeriod {
  id         String          @id @default(cuid())
  exerciseId String
  month      Int
  status     CptPeriodStatus @default(OPEN)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  exercise CptExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  entries  CptEntry[]

  @@unique([exerciseId, month])
  @@index([status])
  @@map("cpt_periods")
}

model CptEntry {
  id               String         @id @default(cuid())
  number           String         @unique
  journalId        String
  periodId         String
  entryDate        DateTime       @db.Date
  label            String
  status           CptEntryStatus @default(DRAFT)
  sourceType       String?
  sourceId         String?
  currencyOriginal String?
  fxRate           Decimal?       @db.Decimal(12, 6)
  amountOriginal   Int?
  createdById      String         @db.Uuid
  validatedById    String?        @db.Uuid
  validatedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  journal     CptJournal     @relation(fields: [journalId], references: [id])
  period      CptPeriod      @relation(fields: [periodId], references: [id])
  createdBy   User           @relation("CptEntryCreator", fields: [createdById], references: [id])
  validatedBy User?          @relation("CptEntryValidator", fields: [validatedById], references: [id])
  lines       CptEntryLine[]
  bankTxns    CptBankTxn[]

  @@index([journalId, entryDate])
  @@index([periodId, status])
  @@index([sourceType, sourceId])
  @@map("cpt_entries")
}

model CptEntryLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  label     String?
  debit     Int     @default(0)
  credit    Int     @default(0)
  sortOrder Int     @default(0)

  entry   CptEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account CptAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("cpt_entry_lines")
}

model CptBankAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  bankName    String   @default("ECOBANK")
  accountRef  String?
  currency    String   @default("XOF")
  cptAccountId String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cptAccount CptAccount   @relation(fields: [cptAccountId], references: [id])
  txns       CptBankTxn[]

  @@index([active])
  @@map("cpt_bank_accounts")
}

model CptBankTxn {
  id             String    @id @default(cuid())
  bankAccountId  String
  txnDate        DateTime  @db.Date
  label          String
  amount         Int
  matchedEntryId String?
  matchedAt      DateTime?
  note           String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bankAccount  CptBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedEntry CptEntry?      @relation(fields: [matchedEntryId], references: [id], onDelete: SetNull)
  createdBy    User           @relation("CptBankTxnCreator", fields: [createdById], references: [id])

  @@index([bankAccountId, txnDate])
  @@index([matchedEntryId])
  @@map("cpt_bank_txns")
}

/// Taux EUR → XOF (paramétrable)
model CptFxRate {
  id        String   @id @default(cuid())
  pair      String   @default("EUR/XOF")
  rate      Decimal  @db.Decimal(12, 6)
  validFrom DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  @@index([pair, validFrom])
  @@map("cpt_fx_rates")
}

model BudExercise {
  id        String   @id @default(cuid())
  year      Int      @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     BudLine[]
  patentes  BudPatenteDue[]

  @@map("bud_exercises")
}

model BudLine {
  id          String    @id @default(cuid())
  exerciseId  String
  nature      BudNature
  category    String
  month       Int
  planned     Int       @default(0)
  actual      Int       @default(0)
  note        String?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exercise  BudExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdBy User        @relation("BudLineCreator", fields: [createdById], references: [id])

  @@unique([exerciseId, nature, category, month])
  @@index([exerciseId, month])
  @@map("bud_lines")
}

/// Suivi patente assisté (échéances + statut)
model BudPatenteDue {
  id         String           @id @default(cuid())
  exerciseId String
  label      String
  dueDate    DateTime         @db.Date
  amount     Int              @default(0)
  status     BudPatenteStatus @default(PENDING)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  exercise BudExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, dueDate])
  @@map("bud_patente_dues")
}

// ─── Phase 4 — RH cœur ───

enum RhEmployeeType {
  SALARIE
  STAGIAIRE
  PRESTATAIRE
  DIRIGEANT
  AUTRE
}

enum RhEmployeeStatus {
  ACTIVE
  ONBOARDING
  OFFBOARDING
  ARCHIVED
}

enum RhReglementStatus {
  PENDING
  SIGNED
  WAIVED
}

enum RhContractType {
  CDI
  CDD
  STAGE
  PRESTA
  AVENANT
  AUTRE
}

enum RhContractStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum RhLeaveType {
  CONGES_PAYES
  SANS_SOLDE
  EXCEPTIONNEL
  MALADIE
  AUTRE
}

enum RhLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RhAbsenceStatus {
  DECLARED
  JUSTIFIED
  UNJUSTIFIED
}

enum RhTimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model RhEmployee {
  id               String            @id @default(cuid())
  userId           String?           @unique @db.Uuid
  firstName        String
  lastName         String
  email            String?
  phone            String?
  jobTitle         String?
  employeeType     RhEmployeeType    @default(SALARIE)
  status           RhEmployeeStatus  @default(ACTIVE)
  hireDate         DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  leaveBalanceDays Decimal           @default(0) @db.Decimal(6, 2)
  reglementStatus  RhReglementStatus @default(PENDING)
  reglementSignedAt DateTime?
  emergencyContact String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user       User?            @relation("RhEmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  contracts  RhContract[]
  leaves     RhLeaveRequest[]
  absences   RhAbsence[]
  timesheets RhTimesheet[]
  payslips   RhPayslip[]
  inpsLines  RhInpsLine[]

  @@index([status, lastName])
  @@map("rh_employees")
}

model RhContract {
  id          String           @id @default(cuid())
  employeeId  String
  type        RhContractType   @default(CDI)
  status      RhContractStatus @default(DRAFT)
  title       String
  startDate   DateTime         @db.Date
  endDate     DateTime?        @db.Date
  salaryXof   Int?
  notes       String?
  gedDocumentId String?
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee RhEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  parent   RhContract? @relation("RhContractAvenant", fields: [parentId], references: [id], onDelete: SetNull)
  avenants RhContract[] @relation("RhContractAvenant")

  @@index([employeeId, status])
  @@map("rh_contracts")
}

model RhLeaveRequest {
  id           String        @id @default(cuid())
  employeeId   String
  requesterId  String        @db.Uuid
  type         RhLeaveType   @default(CONGES_PAYES)
  status       RhLeaveStatus @default(PENDING)
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  days         Decimal       @db.Decimal(5, 2)
  reason       String?
  validatedById String?      @db.Uuid
  validatedAt  DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee    RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requester   User       @relation("RhLeaveRequester", fields: [requesterId], references: [id])
  validatedBy User?      @relation("RhLeaveValidator", fields: [validatedById], references: [id])

  @@index([employeeId, status])
  @@index([status, startDate])
  @@map("rh_leave_requests")
}

model RhAbsence {
  id            String          @id @default(cuid())
  employeeId    String
  declaredById  String          @db.Uuid
  status        RhAbsenceStatus @default(DECLARED)
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date
  reason        String
  justificationNote String?
  reviewedById  String?         @db.Uuid
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  employee   RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  declaredBy User       @relation("RhAbsenceDeclarer", fields: [declaredById], references: [id])
  reviewedBy User?      @relation("RhAbsenceReviewer", fields: [reviewedById], references: [id])

  @@index([employeeId, status])
  @@map("rh_absences")
}

model RhTimesheet {
  id            String            @id @default(cuid())
  employeeId    String
  ownerId       String            @db.Uuid
  weekStart     DateTime          @db.Date
  status        RhTimesheetStatus @default(DRAFT)
  totalMinutes  Int               @default(0)
  note          String?
  validatedById String?           @db.Uuid
  validatedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  employee    RhEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  owner       User               @relation("RhTimesheetOwner", fields: [ownerId], references: [id])
  validatedBy User?              @relation("RhTimesheetValidator", fields: [validatedById], references: [id])
  lines       RhTimesheetLine[]

  @@unique([employeeId, weekStart])
  @@index([status, weekStart])
  @@map("rh_timesheets")
}

model RhTimesheetLine {
  id           String   @id @default(cuid())
  timesheetId  String
  workDate     DateTime @db.Date
  minutes      Int      @default(0)
  label        String?

  timesheet RhTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
  @@map("rh_timesheet_lines")
}

// ─── Phase 5 — Paie + INPS ───

enum RhPayrollPeriodStatus {
  DRAFT
  OPEN
  CALCULATED
  APPROVED
  CLOSED
}

enum RhPayslipStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum RhInpsLineStatus {
  DRAFT
  CALCULATED
  DECLARED
  PAID
}

/// Paramètres cotisations (versionnés). ratesJson = [{code,label,rate,party}]
model RhInpsSettings {
  id                String   @id @default(cuid())
  effectiveFrom     DateTime @db.Date
  ratesJson         Json
  declarationPeriod String   @default("monthly")
  paymentDueDay     Int      @default(15)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([effectiveFrom])
  @@map("rh_inps_settings")
}

model RhPayrollPeriod {
  id           String                @id @default(cuid())
  year         Int
  month        Int
  status       RhPayrollPeriodStatus @default(OPEN)
  openedById   String                @db.Uuid
  approvedById String?               @db.Uuid
  approvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  openedBy   User         @relation("RhPayrollOpener", fields: [openedById], references: [id])
  approvedBy User?        @relation("RhPayrollApprover", fields: [approvedById], references: [id])
  slips      RhPayslip[]
  inpsLines  RhInpsLine[]

  @@unique([year, month])
  @@index([status, year, month])
  @@map("rh_payroll_periods")
}

model RhPayslip {
  id                  String         @id @default(cuid())
  periodId            String
  employeeId          String
  contractId          String?
  status              RhPayslipStatus @default(DRAFT)
  baseSalaryXof       Int
  primesXof           Int            @default(0)
  brutXof             Int
  employeeDeductXof   Int            @default(0)
  employerChargesXof  Int            @default(0)
  netXof              Int
  gedDocumentId       String?
  cptEntryId          String?
  paidAt              DateTime?
  paymentRef          String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  period   RhPayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee RhEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    RhPayslipLine[]
  inpsLine RhInpsLine?

  @@unique([periodId, employeeId])
  @@index([employeeId, status])
  @@map("rh_payslips")
}

model RhPayslipLine {
  id         String  @id @default(cuid())
  payslipId  String
  code       String
  label      String
  kind       String
  rate       Decimal? @db.Decimal(8, 6)
  amountXof  Int
  sortOrder  Int     @default(0)

  payslip RhPayslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("rh_payslip_lines")
}

model RhInpsLine {
  id                       String           @id @default(cuid())
  periodId                 String
  employeeId               String
  payslipId                String?          @unique
  baseAmountXof            Int
  employeeContributionXof  Int
  employerContributionXof  Int
  status                   RhInpsLineStatus @default(DRAFT)
  paymentRef               String?
  declaredAt               DateTime?
  paidAt                   DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  period   RhPayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee RhEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslip  RhPayslip?      @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  @@unique([periodId, employeeId])
  @@index([status])
  @@map("rh_inps_lines")
}

/// Éligibilité paie / INPS / congés par type de contrat (activable).
model RhContractTypeRule {
  id               String         @id @default(cuid())
  contractType     RhContractType @unique
  includeInPayroll Boolean        @default(true)
  applyInpsRates   Boolean        @default(true)
  accruePaidLeave  Boolean        @default(true)
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("rh_contract_type_rules")
}

// ─── Phase 7A — Stocks ───

enum StkMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
}

model StkArticle {
  id           String   @id @default(cuid())
  code         String   @unique
  family       String
  subFamily    String?
  designation  String
  unit         String   @default("U")
  qtyOnHand    Decimal  @default(0) @db.Decimal(14, 3)
  stockMin     Decimal  @default(0) @db.Decimal(14, 3)
  location     String?
  unitCostXof  Int?
  observations String?
  active       Boolean  @default(true)
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy  User?          @relation("StkArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  movements  StkMovement[]
  purchaseLines StkPurchaseLine[]

  @@index([family, active])
  @@index([qtyOnHand, stockMin])
  @@map("stk_articles")
}

model StkMovement {
  id          String          @id @default(cuid())
  articleId   String
  type        StkMovementType
  quantity    Decimal         @db.Decimal(14, 3)
  qtyBefore   Decimal         @db.Decimal(14, 3)
  qtyAfter    Decimal         @db.Decimal(14, 3)
  reason      String?
  movedAt     DateTime        @default(now())
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())

  article   StkArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)
  createdBy User       @relation("StkMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([articleId, movedAt])
  @@index([type, movedAt])
  @@map("stk_movements")
}

// ─── Phase 7B — Ops (achats, patrimoine, projets, anomalies) ───

enum StkPurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum PatAssetStatus {
  IN_SERVICE
  MAINTENANCE
  DISPOSED
}

enum PrjProjectStatus {
  ACTIVE
  ON_HOLD
  DONE
  CANCELLED
}

enum PrjExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

enum OpsTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OpsTicketStatus {
  TODO
  IN_PROGRESS
  DONE
  DEFERRED
}

model StkPurchase {
  id              String            @id @default(cuid())
  number          String            @unique
  supplierName    String
  supplierContact String?
  status          StkPurchaseStatus @default(DRAFT)
  orderedAt       DateTime?
  receivedAt      DateTime?
  notes           String?
  cptEntryId      String?
  createdById     String            @db.Uuid
