  manager    RhEmployee?      @relation("RhEmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  reports    RhEmployee[]     @relation("RhEmployeeManager")
  contracts  RhContract[]
  leaves     RhLeaveRequest[]
