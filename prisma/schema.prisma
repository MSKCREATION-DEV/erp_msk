  createdAt DateTime @default(now())

  @@unique([date])
  @@index([year])
  @@map("rh_public_holidays")
}

model RhContract {
  id          String           @id @default(cuid())
  employeeId  String
  type        RhContractType   @default(CDI)
  status      RhContractStatus @default(DRAFT)
  title       String
  startDate   DateTime         @db.Date
  endDate     DateTime?        @db.Date
  salaryXof   Int?
  notes       String?
  gedDocumentId String?
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee RhEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  parent   RhContract? @relation("RhContractAvenant", fields: [parentId], references: [id], onDelete: SetNull)
  avenants RhContract[] @relation("RhContractAvenant")

  @@index([employeeId, status])
  @@map("rh_contracts")
}

model RhLeaveRequest {
  id           String        @id @default(cuid())
  employeeId   String
  requesterId  String        @db.Uuid
  type         RhLeaveType   @default(CONGES_PAYES)
  status       RhLeaveStatus @default(PENDING)
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  days         Decimal       @db.Decimal(5, 2)
  reason       String?
  validatedById String?      @db.Uuid
  validatedAt  DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee    RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requester   User       @relation("RhLeaveRequester", fields: [requesterId], references: [id])
  validatedBy User?      @relation("RhLeaveValidator", fields: [validatedById], references: [id])

  @@index([employeeId, status])
  @@index([status, startDate])
  @@map("rh_leave_requests")
}

model RhAbsence {
  id            String          @id @default(cuid())
  employeeId    String
  declaredById  String          @db.Uuid
  status        RhAbsenceStatus @default(DECLARED)
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date
  reason        String
  justificationNote String?
  /// Justificatif GED (PDF / image) — optionnel à la déclaration.
  gedDocumentId String?
  reviewedById  String?         @db.Uuid
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  employee   RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  declaredBy User       @relation("RhAbsenceDeclarer", fields: [declaredById], references: [id])
  reviewedBy User?      @relation("RhAbsenceReviewer", fields: [reviewedById], references: [id])

  @@index([employeeId, status])
  @@map("rh_absences")
}

model RhTimesheet {
  id            String            @id @default(cuid())
