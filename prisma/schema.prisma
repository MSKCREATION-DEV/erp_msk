// ERP MSK CREATION — Phase 0–4 + 6 (IAM, GED, Catalogue/CRM, Commercial, RH, Comptabilité)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITE_PENDING
  MUST_CHANGE_PASSWORD
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OverrideEffect {
  GRANT
  DENY
}

enum ResetRequestStatus {
  PENDING
  DONE
  CANCELLED
}

enum DocVisibility {
  PRIVATE_SELF
  GROUP
  RH_ONLY
  DIRECTION
  COMPANY
  CUSTOM
}

enum DocStatus {
  ACTIVE
  ARCHIVED
  TRASH
}

enum AclRight {
  VIEW
  UPLOAD
  EDIT_META
  MANAGE_SHARE
}

enum SignatureKind {
  UPLOAD
}

enum SignatureStatus {
  DRAFT
  ACTIVE
  REVOKED
}

enum TemplateType {
  DEVIS
  FACTURE
  /// Contrat client commercial (familles A/B) — `generateContractPdf`.
  CONTRAT_COMMERCIAL
  CONTRAT_TRAVAIL
  CONTRAT_STAGE
  CONTRAT_PRESTA
  ATTESTATION_STAGE
  REGLEMENT_INTERIEUR
  SOLDE_TOUT_COMPTE
  FICHE_PAIE
}

enum CatalogPillar {
  IMAGE_MARQUE
  CONTENU_COMMUNICATION
  PRESENCE_DIGITALE
  CROISSANCE_ACQUISITION
  TRANSFORMATION_STRUCTURATION
}

enum CatalogBilling {
  ONE_SHOT
  MONTHLY
  PACKAGE
  RECURRING
  SUR_DEVIS
  COMPLEMENTAIRE
}

enum CatalogPriceMode {
  FIXED
  FROM
  CUSTOM
}

enum CrmSource {
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  TIKTOK
  GOOGLE_MAPS
  GOOGLE
  SNAPCHAT
  TERRAIN
  RECOMMANDATION
  EMAIL
  TELEPHONE
  AUTRE
}

enum CrmPipelineStage {
  NOUVEAU
  CONTACTE
  QUALIFICATION
  INTERESSE
  DEVIS_ENVOYE
  NEGOCIATION
  GAGNE
  PERDU
}

enum CrmActivityType {
  APPEL
  WHATSAPP
  INSTAGRAM
  LINKEDIN
  EMAIL
  RDV
  NOTE
  AUTRE
}

enum CrmAssignmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CrmTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum CrmAppointmentStatus {
  SCHEDULED
  DONE
  NO_SHOW
  CANCELLED
}

enum CrmLossReason {
  BUDGET
  CONCURRENT
  TIMING
  NO_SHOW
  AUTRE
}

/// LOT-F — moyens de joindre une personne-contact.
enum CrmContactChannelType {
  PHONE
  EMAIL
  WHATSAPP
  INSTAGRAM
  LINKEDIN
  AUTRE
}

enum ComDocRegime {
  ML
  FR
}

enum ComDocKind {
  DEVIS
  FACTURE
  AVOIR
  BDC
  CONTRAT
}

enum ComQuoteStatus {
  BROUILLON
  EMISE
  ENVOYE
  CONSULTE
  ACCEPTE
  REFUSE
  EXPIRE
  ANNULE
}

enum ComQuoteTemplate {
  LINE_ITEMS
  COMPARATIVE_RS
  CUSTOM
}

enum ComInvoiceStatus {
  BROUILLON
  EMISE
  ENVOYEE
  PARTIELLEMENT_PAYEE
  PAYEE
  EN_RETARD
  ANNULEE
  AVOIREE
}

enum ComInvoiceSource {
  QUOTE
  CONTRACT
  MANUAL
  IMPORT
}

enum ComPaymentMethod {
  ESPECES
  VIREMENT
  ORANGE_MONEY
  WAVE
  MOBILE_MONEY
  CHEQUE
  AUTRE
}

enum ComPaymentStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum ComClientStatus {
  PROSPECT
  ACTIF
  SUSPENDU
  TERMINE
  ARCHIVE
}

enum ComClientType {
  ENTREPRISE
  PARTICULIER
}

enum ComContractStatus {
  BROUILLON
  ACTIF
  SUSPENDU
  RESILIE
  TERMINE
}

enum ComContractLineStatus {
  ACTIF
  SUSPENDU
  RESILIE
  TERMINE
}

/// Famille document contrat (analyse §6.1) — pilote le template PDF (P4).
enum ComContractFamily {
  PRESTATION_ABONNEMENT
  ENGAGEMENT_CDC
}

/// Nature de prestation — sélectionne les blocs conditionnels du template.
enum ComServiceKind {
  RESEAUX_SOCIAUX
  APPLICATION_WEB
  SITE_VITRINE
  CHARTE_GRAPHIQUE
  AUTRE
  BUNDLE
}

/// Origine de la composition commerciale consommée par le contrat (Q3).
enum ComCompositionSource {
  QUOTE
  INLINE
}

enum ComImportBatchStatus {
  DRY_RUN
  PENDING_REVIEW
  COMMITTED
  CANCELLED
}

enum ComImportAnomalySeverity {
  WARNING
  ERROR
}

/// Singleton single-tenant MSK (id fixe = "msk")
model OrganizationSettings {
  id               String   @id @default("msk")
  legalName        String   @default("MSK CREATION")
  tradeName        String   @default("MSK CREATION")
  defaultCurrency  String   @default("XOF")
  defaultVatRate   Decimal  @default(18.00) @db.Decimal(5, 2)
  frVatRate        Decimal  @default(20.00) @db.Decimal(5, 2)
  countryCode      String   @default("ML")
  timezone         String   @default("Africa/Bamako")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("organization_settings")
}

/// Profil applicatif lié à auth.users (id = UUID Supabase Auth)
model User {
  id                 String     @id @db.Uuid
  email              String     @unique
  firstName          String
  lastName           String
  phone              String?
  status             UserStatus @default(INVITE_PENDING)
  isSuperAdmin       Boolean    @default(false)
  mustChangePassword Boolean    @default(true)
  invitedAt          DateTime?
  activatedAt        DateTime?
  lastLoginAt        DateTime?
  suspendedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  groupMembers   GroupMember[]
  userPacks      UserPack[]
  overrides      UserPermissionOverride[]
  auditLogs      AuditLog[]              @relation("AuditActor")
  resetRequests  PasswordResetRequest[]  @relation("ResetSubject")
  resetsResolved PasswordResetRequest[]  @relation("ResetResolver")
  foldersCreated DocumentFolder[]        @relation("FolderCreator")
  docsCreated    Document[]              @relation("DocCreator")
  documentAcls   DocumentAcl[]
  signatures     SignatureAsset[]
  orgNodes       OrgNode[]
  crmOrgsOwned   CrmOrganization[] @relation("CrmOrgOwner")
  crmOrgsCreated CrmOrganization[] @relation("CrmOrgCreator")
  crmDealsOwned CrmOpportunity[]  @relation("CrmDealOwner")
  crmDealsCreated CrmOpportunity[] @relation("CrmDealCreator")
  crmActivities CrmActivity[]     @relation("CrmActivityActor")
  crmTasksAssigned CrmTask[]      @relation("CrmTaskAssignee")
  crmTasksCreated  CrmTask[]      @relation("CrmTaskCreator")
  crmWeeklyReports CrmWeeklyReport[] @relation("CrmWeeklyReportAuthor")
  crmPeriodGoals    CrmPeriodGoal[]   @relation("CrmPeriodGoalUser")
  crmAssignmentRequests CrmAssignmentRequest[] @relation("CrmAssignmentRequester")
  crmAssignmentResolved CrmAssignmentRequest[] @relation("CrmAssignmentResolver")
  crmAppointmentsAssigned CrmAppointment[] @relation("CrmAppointmentAssignee")
  crmAppointmentsCreated  CrmAppointment[] @relation("CrmAppointmentCreator")
  appNotifications AppNotification[]
  comClientsOwned  ComClient[]     @relation("ComClientOwner")
  comClientsCreated ComClient[]    @relation("ComClientCreator")
  comQuotesOwned   ComQuote[]      @relation("ComQuoteOwner")
  comQuotesCreated ComQuote[]      @relation("ComQuoteCreator")
  comInvoicesOwned ComInvoice[]    @relation("ComInvoiceOwner")
  comInvoicesCreated ComInvoice[]  @relation("ComInvoiceCreator")
  comPaymentsRecorded ComPayment[] @relation("ComPaymentRecorder")
  comContractsOwned   ComContract[]  @relation("ComContractOwner")
  comContractsCreated ComContract[]  @relation("ComContractCreator")
  comCreditNotesCreated ComCreditNote[] @relation("ComCreditNoteCreator")
  comClientEvents     ComClientEvent[] @relation("ComClientEventActor")
  comImportBatches    ComImportBatch[] @relation("ComImportBatchCreator")
  cptEntriesCreated   CptEntry[]     @relation("CptEntryCreator")
  cptEntriesValidated CptEntry[]     @relation("CptEntryValidator")
  cptBankTxnsCreated  CptBankTxn[]   @relation("CptBankTxnCreator")
  budLinesCreated     BudLine[]      @relation("BudLineCreator")
  rhEmployee          RhEmployee?    @relation("RhEmployeeUser")
  rhLeavesRequested   RhLeaveRequest[] @relation("RhLeaveRequester")
  rhLeavesValidated   RhLeaveRequest[] @relation("RhLeaveValidator")
  rhAbsencesDeclared  RhAbsence[]      @relation("RhAbsenceDeclarer")
  rhAbsencesReviewed  RhAbsence[]      @relation("RhAbsenceReviewer")
  rhTimesheetsOwned   RhTimesheet[]    @relation("RhTimesheetOwner")
  rhTimesheetsValidated RhTimesheet[]  @relation("RhTimesheetValidator")
  rhPayrollOpened     RhPayrollPeriod[] @relation("RhPayrollOpener")
  rhPayrollApproved   RhPayrollPeriod[] @relation("RhPayrollApprover")
  rhProfileChangesRequested RhProfileChangeRequest[] @relation("RhProfileChangeRequester")
  rhProfileChangesReviewed  RhProfileChangeRequest[] @relation("RhProfileChangeReviewer")
  rhLeaveMovementsCreated   RhLeaveMovement[]        @relation("RhLeaveMovementCreator")
  stkArticlesCreated  StkArticle[]      @relation("StkArticleCreator")
  stkMovementsCreated StkMovement[]     @relation("StkMovementCreator")
  stkPurchasesCreated StkPurchase[]     @relation("StkPurchaseCreator")
  patAssetsCreated    PatAsset[]        @relation("PatAssetCreator")
  patAssetsAssigned   PatAsset[]        @relation("PatAssetAssignee")
  prjProjectsOwned    PrjProject[]      @relation("PrjProjectOwner")
  prjMemberships      PrjMember[]
  prjExpensesCreated  PrjExpense[]      @relation("PrjExpenseCreator")
  prjExpensesReviewed PrjExpense[]      @relation("PrjExpenseReviewer")
  opsTicketsCreated   OpsTicket[]       @relation("OpsTicketCreator")
  opsTicketsAssigned  OpsTicket[]       @relation("OpsTicketAssignee")
  svInvoicesCreated          SvInvoice[]         @relation("SvInvoiceCreator")
  svExpenseInvoicesCreated   SvExpenseInvoice[]  @relation("SvExpenseInvoiceCreator")
  svCashMovementsCreated     SvCashMovement[]    @relation("SvCashMovementCreator")
  svStockMovementsCreated    SvStockMovement[]   @relation("SvStockMovementCreator")

  @@index([status])
  @@map("users")
}

model Group {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String?
  defaultPackId String?
  sortOrder     Int     @default(0)

  defaultPack PermissionPack? @relation("GroupDefaultPack", fields: [defaultPackId], references: [id], onDelete: SetNull)
  members     GroupMember[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  domain      String
  description String?

  packItems PackPermission[]
  overrides UserPermissionOverride[]

  @@index([domain])
  @@map("permissions")
}

model PermissionPack {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)

  permissions   PackPermission[]
  userPacks     UserPack[]
  groupsDefault Group[]          @relation("GroupDefaultPack")

  @@map("permission_packs")
}

model PackPermission {
  packId       String
  permissionId String

  pack       PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([packId, permissionId])
  @@map("pack_permissions")
}

model UserPack {
  userId    String   @db.Uuid
  packId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack PermissionPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([userId, packId])
  @@index([packId])
  @@map("user_packs")
}

model UserPermissionOverride {
  id           String         @id @default(cuid())
  userId       String         @db.Uuid
  permissionId String
  effect       OverrideEffect
  reason       String?
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PasswordResetRequest {
  id                String             @id @default(cuid())
  userId            String             @db.Uuid
  requesterEmail    String?
  status            ResetRequestStatus @default(PENDING)
  note              String?
  createdAt         DateTime           @default(now())
  resolvedAt        DateTime?
  resolvedById      String?            @db.Uuid

  user       User  @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ResetResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("password_reset_requests")
}

// ─── Phase 1 GED ───────────────────────────────────────────────

model DocumentFolder {
  id         String        @id @default(cuid())
  parentId   String?
  name       String
  code       String
  path       String
  year       Int?
  visibility DocVisibility @default(COMPANY)
  createdById String?      @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]
  acls      DocumentAcl[]
  createdBy User?            @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([path])
  @@index([parentId])
  @@index([year])
  @@index([code])
  @@map("document_folders")
}

model Document {
  id           String        @id @default(cuid())
  folderId     String
  storagePath  String
  originalName String
  mime         String
  size         Int
  checksum     String?
  version      Int           @default(1)
  status       DocStatus     @default(ACTIVE)
  visibility   DocVisibility @default(COMPANY)
  createdById  String?       @db.Uuid
  softDeletedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  folder    DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("DocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  links     DocumentLink[]
  acls      DocumentAcl[]

  @@index([folderId])
  @@index([status])
  @@index([softDeletedAt])
  @@map("documents")
}

model DocumentLink {
  id         String @id @default(cuid())
  documentId String
  entityType String
  entityId   String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

model DocumentAcl {
  id         String    @id @default(cuid())
  folderId   String?
  documentId String?
  userId     String    @db.Uuid
  right      AclRight  @default(VIEW)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([documentId])
  @@index([userId])
  @@map("document_acls")
}

model BrandAsset {
  id        String   @id @default(cuid())
  kind      String   @unique
  label     String
  publicPath String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_assets")
}

model SignatureAsset {
  id              String          @id @default(cuid())
  ownerUserId     String?         @db.Uuid
  orgOwned        Boolean         @default(false)
  kind            SignatureKind   @default(UPLOAD)
  label           String
  storageOriginal String
  /** PNG fond transparent après pipeline de nettoyage (null = pas encore traité). */
  storageCleaned  String?
  mime            String
  status          SignatureStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([status])
  @@map("signature_assets")
}

model OrgNode {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  title     String
  fullName  String
  email     String?
  photoPath String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   OrgNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgNode[] @relation("OrgTree")

  @@index([parentId])
  @@index([sortOrder])
  @@map("org_nodes")
}

model DocumentTemplate {
  id            String       @id @default(cuid())
  type          TemplateType
  code          String       @unique
  name          String
  version       Int          @default(1)
  structureJson Json         @default("{}")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@map("document_templates")
}

/// Offre catalogue MSK (5 piliers)
model CatalogOffer {
  id            String           @id @default(cuid())
  sku           String           @unique
  name          String
  description   String?
  /// Description commerciale longue (devis).
  longDescription String?
  pillar        CatalogPillar
  billing       CatalogBilling   @default(ONE_SHOT)
  priceMode     CatalogPriceMode @default(FIXED)
  priceXof      Int?
  /// Plancher commercial — prix unitaire devis ne peut pas descendre en dessous.
  floorPriceXof Int?
  priceEurHint  Int?
  currency      String           @default("XOF")
  vatEligible   Boolean          @default(true)
  minEngagementMonths Int?
  conditions    String?
  /// Prestations incluses / exclues / options (JSON structuré).
  featuresJson  Json?
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  /// Schéma UI options (RS / WEB / ECOM…) — JSON OfferOptionSchema.
  optionSchema  Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  versions      CatalogOfferVersion[]
  opportunities CrmOpportunity[]
  opportunityOffers CrmOpportunityOffer[]
  quoteLines    ComQuoteLine[]
  invoiceLines  ComInvoiceLine[]
  contractLines ComContractLine[]

  @@index([pillar, active])
  @@map("catalog_offers")
}

/// Version immuable d’une offre (contrats / devis historiques).
model CatalogOfferVersion {
  id              String   @id @default(cuid())
  catalogOfferId  String
  version         Int
  isOfficial      Boolean  @default(false)
  sku             String
  name            String
  description     String?
  billing         CatalogBilling
  priceMode       CatalogPriceMode
  priceXof        Int?
  floorPriceXof   Int?
  vatEligible     Boolean  @default(true)
  featuresJson    Json?
  snapshotJson    Json
  createdAt       DateTime @default(now())

  catalogOffer  CatalogOffer      @relation(fields: [catalogOfferId], references: [id], onDelete: Cascade)
  contractLines ComContractLine[]

  @@unique([catalogOfferId, version])
  @@index([sku, version])
  @@map("catalog_offer_versions")
}

model CrmOrganization {
  id            String     @id @default(cuid())
  name          String
  normalizedName String
  sector        String?
  city          String?
  country       String     @default("ML")
  website       String?
  /// LOT-F / P2-1 — réseaux sociaux entreprise (URLs).
  instagramUrl  String?
  linkedinUrl   String?
  tiktokUrl     String?
  facebookUrl   String?
  whatsappUrl   String?
  source        CrmSource?
  notes         String?
  ownerId       String     @db.Uuid
  createdById   String     @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner       User             @relation("CrmOrgOwner", fields: [ownerId], references: [id])
  createdBy   User             @relation("CrmOrgCreator", fields: [createdById], references: [id])
  contacts    CrmContact[]
  opportunities CrmOpportunity[]
  activities  CrmActivity[]
  tasks       CrmTask[]
  comClients  ComClient[]

  @@index([ownerId])
  @@index([normalizedName])
  @@map("crm_organizations")
}

model CrmContact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  jobTitle       String?
  /// Miroir du canal principal EMAIL (compat listes / convert).
  email          String?
  /// Miroir du canal principal PHONE / WHATSAPP.
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization CrmOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channels     CrmContactChannel[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@map("crm_contacts")
}

model CrmContactChannel {
  id        String                @id @default(cuid())
  contactId String
  type      CrmContactChannelType
  value     String
  /// Valeur normalisée pour recherche doublons (digits tél / email lower).
  normalizedValue String
  isPrimary Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([normalizedValue])
  @@index([type, normalizedValue])
  @@map("crm_contact_channels")
}

model CrmOpportunity {
  id              String           @id @default(cuid())
  organizationId  String
  title           String
  stage           CrmPipelineStage @default(NOUVEAU)
  source          CrmSource?
  offerLabel      String?
  catalogOfferId  String?
  budgetXof       Int?
  probability     Int?             // 0..100
  expectedCloseAt DateTime?
  lossReason      CrmLossReason?
  lossNote        String?
  ownerId         String           @db.Uuid
  createdById     String           @db.Uuid
  lastActivityAt  DateTime?
  nextAction      String?
  followUpAt      DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  /// Entrée en statut Intéressé — SLA devis 24h (GUIDE).
  interestedAt    DateTime?        @map("interested_at")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization CrmOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer?   @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)
  owner        User            @relation("CrmDealOwner", fields: [ownerId], references: [id])
  createdBy    User            @relation("CrmDealCreator", fields: [createdById], references: [id])
  activities   CrmActivity[]
  tasks        CrmTask[]
  appointments CrmAppointment[]
  opportunityOffers CrmOpportunityOffer[]
  comClients   ComClient[]
  comQuotes    ComQuote[]
  assignmentRequests CrmAssignmentRequest[]

  @@index([ownerId, stage])
  @@index([organizationId])
  @@index([followUpAt])
  @@map("crm_opportunities")
}

/// Demande d’affectation du suivi (commercial → Direction / Admin CRM).
model CrmAssignmentRequest {
  id            String                      @id @default(cuid())
  opportunityId String
  requesterId   String                      @db.Uuid
  message       String?
  status        CrmAssignmentRequestStatus  @default(PENDING)
  createdAt     DateTime                    @default(now())
  resolvedAt    DateTime?
  resolvedById  String?                     @db.Uuid
  resolveNote   String?

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  requester   User           @relation("CrmAssignmentRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  resolvedBy  User?          @relation("CrmAssignmentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([opportunityId, status])
  @@index([requesterId])
  @@map("crm_assignment_requests")
}

/// Offres proposées à un prospect (N:N) + config options.
model CrmOpportunityOffer {
  id             String   @id @default(cuid())
  opportunityId  String
  catalogOfferId String
  config         Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity  CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer   @relation(fields: [catalogOfferId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, catalogOfferId])
  @@index([opportunityId])
  @@map("crm_opportunity_offers")
}

model CrmActivity {
  id             String         @id @default(cuid())
  organizationId String?
  opportunityId  String?
  type           CrmActivityType
  summary        String
  body           String?
  occurredAt     DateTime       @default(now())
  actorId        String         @db.Uuid
  createdAt      DateTime       @default(now())

  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor        User             @relation("CrmActivityActor", fields: [actorId], references: [id])

  @@index([opportunityId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("crm_activities")
}

model CrmTask {
  id             String        @id @default(cuid())
  organizationId String?
  opportunityId  String?
  title          String
  dueAt          DateTime
  status         CrmTaskStatus @default(OPEN)
  assigneeId     String        @db.Uuid
  createdById    String        @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee     User             @relation("CrmTaskAssignee", fields: [assigneeId], references: [id])
  createdBy    User             @relation("CrmTaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, status, dueAt])
  @@index([dueAt])
  @@map("crm_tasks")
}

model CrmAppointment {
  id             String               @id @default(cuid())
  opportunityId  String
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  notes          String?
  status         CrmAppointmentStatus @default(SCHEDULED)
  assigneeId     String               @db.Uuid
  createdById    String               @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee    User           @relation("CrmAppointmentAssignee", fields: [assigneeId], references: [id])
  createdBy   User           @relation("CrmAppointmentCreator", fields: [createdById], references: [id])

  @@index([assigneeId, startsAt])
  @@index([opportunityId, startsAt])
  @@index([status, startsAt])
  @@map("crm_appointments")
}

/// Notifications in-app (écriture Prisma uniquement ; Realtime SELECT own).
model AppNotification {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  title       String
  body        String?
  href        String?
  kind        String
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("app_notifications")
}

model CrmScript {
  id        String    @id @default(cuid())
  code      String    @unique
  channel   CrmSource
  title     String
  body      String
  tips      String?
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([channel, active])
  @@map("crm_scripts")
}

/// Objectifs CRM ancrés à une période (jour / semaine / mois).
model CrmPeriodGoal {
  id          String   @id @default(cuid())
  /// USER = un collab ; TEAM = objectif pôle (userId null).
  scope       String
  userId      String?  @db.Uuid
  /// NEW_PROSPECTS | FIRST_CONTACTS | MEETINGS | FOLLOW_UPS
  metric      String
  /// DAY | WEEK | MONTH
  periodType  String
  /// Début de période (UTC date) : jour ; lundi ISO ; 1er du mois.
  periodStart DateTime @db.Date
  target      Int
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User? @relation("CrmPeriodGoalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, userId, metric, periodType, periodStart])
  @@index([scope, metric])
  @@index([periodType, periodStart])
  @@map("crm_period_goals")
}

/// Rapport de semaine (vendredi) — chiffres préremplis + qualitatif.
model CrmWeeklyReport {
  id              String   @id @default(cuid())
  authorId        String   @db.Uuid
  /// Lundi 00:00 de la semaine concernée (UTC date).
  weekStart       DateTime @db.Date
  newProspects    Int      @default(0)
  firstContacts   Int      @default(0)
  replies         Int      @default(0)
  inDiscussion    Int      @default(0)
  qualified       Int      @default(0)
  meetings        Int      @default(0)
  followUpsDone   Int      @default(0)
  difficulty      String?
  needs           String?
  scriptsFeedback String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author User @relation("CrmWeeklyReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, weekStart])
  @@index([weekStart])
  @@map("crm_weekly_reports")
}

/// Séquences documentaires — periodKey = YYYYMMDD (ou YYYY legacy).
model ComNumberSequence {
  id         String     @id @default(cuid())
  kind       ComDocKind
  periodKey  String
  lastValue  Int        @default(0)
  updatedAt  DateTime   @updatedAt

  @@unique([kind, periodKey])
  @@map("com_number_sequences")
}

model ComClient {
  id                   String          @id @default(cuid())
  name                 String
  normalizedName       String
  legalName            String?
  clientType           ComClientType   @default(ENTREPRISE)
  status               ComClientStatus @default(ACTIF)
  sector               String?
  /// Code dossier GED unique sous `03_CLIENTS` (évite collision nom → slug).
  gedFolderCode        String          @unique
  contactName          String?
  contactRole          String?
  email                String?
  phone                String?
  website              String?
  address              String?
  city                 String?
  country              String          @default("ML")
  taxId                String?
  notes                String?
  includeTravelDefault Boolean         @default(false)
  crmOrganizationId    String?
  sourceOpportunityId  String?
  ownerId              String          @db.Uuid
  createdById          String          @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  crmOrganization   CrmOrganization? @relation(fields: [crmOrganizationId], references: [id], onDelete: SetNull)
  sourceOpportunity CrmOpportunity?  @relation(fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  owner             User             @relation("ComClientOwner", fields: [ownerId], references: [id])
  createdBy         User             @relation("ComClientCreator", fields: [createdById], references: [id])
  quotes            ComQuote[]
  invoices          ComInvoice[]
  contracts         ComContract[]
  payments          ComPayment[]
  creditNotes       ComCreditNote[]
  events            ComClientEvent[]

  @@index([ownerId])
  @@index([normalizedName])
  @@index([crmOrganizationId])
  @@index([status])
  @@map("com_clients")
}

model ComQuote {
  id              String           @id @default(cuid())
  /// Numéro officiel (null tant que brouillon non émis).
  number          String?          @unique
  draftCode       String           @unique
  legacyNumber    String?
  legacyInternalRef String?
  status          ComQuoteStatus   @default(BROUILLON)
  template        ComQuoteTemplate @default(LINE_ITEMS)
  revision        Int              @default(1)
  regime          ComDocRegime     @default(ML)
  currency        String           @default("XOF")
  vatEnabled      Boolean          @default(true)
  vatRate         Int              @default(18)
  promoEnabled    Boolean          @default(false)
  promoPercent    Int?
  includeTravel   Boolean          @default(false)
  object          String?
  missionNote     String?
  conditionsJson  Json?
  validUntil      DateTime?
  totalHt         Int              @default(0)
  totalVat        Int              @default(0)
  totalTtc        Int              @default(0)
  clientId        String
  opportunityId   String?
  ownerId         String           @db.Uuid
  createdById     String           @db.Uuid
  gedDocumentId   String?
  issuedAt        DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client      ComClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User            @relation("ComQuoteOwner", fields: [ownerId], references: [id])
  createdBy   User            @relation("ComQuoteCreator", fields: [createdById], references: [id])
  lines       ComQuoteLine[]
  invoices    ComInvoice[]
  contracts   ComContract[]

  @@index([clientId])
  @@index([ownerId, status])
  @@index([legacyNumber])
  @@index([createdAt])
  /// Un seul devis lié par prospect (NULL autorisé plusieurs fois en PG).
  @@unique([opportunityId])
  @@map("com_quotes")
}

model ComQuoteLine {
  id             String  @id @default(cuid())
  quoteId        String
  sortOrder      Int     @default(0)
  label          String
  description    String?
  qty            Int     @default(1)
  unitPrice      Int
  catalogOfferId String?
  isTravel       Boolean @default(false)
  /// Snapshot optionnel au moment de la ligne.
  snapshotJson   Json?

  quote        ComQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer? @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("com_quote_lines")
}

model ComContract {
  id              String            @id @default(cuid())
  reference       String            @unique
  status          ComContractStatus @default(BROUILLON)
  title           String?
  /// Famille document (analyse contrats §6.1) — pilote le template PDF.
  family          ComContractFamily?
  /// Nature de prestation — sélectionne les blocs de template (§6.1/§6.2).
  serviceKind     ComServiceKind?
  regime          ComDocRegime      @default(ML)
  currency        String            @default("XOF")
  vatEnabled      Boolean           @default(true)
  vatRate         Int               @default(18)
  billingDay      Int               @default(5)
  startDate       DateTime?
  endDate         DateTime?
  paymentTerms    String?
  renewalTerms    String?
  terminationTerms String?
  notes           String?
  /// Origine de la composition commerciale (devis accepté vs saisie libre — Q3).
  compositionSource ComCompositionSource @default(INLINE)
  /// Périmètre famille B (contexte / objectifs / livrables / hors-périmètre…) — JSON libre (analyse §6.3 `scope`).
  scopeJson       Json?
  clientId        String
  quoteId         String?
  ownerId         String            @db.Uuid
  createdById     String            @db.Uuid
  signedAt        DateTime?
  /// PDF contrat généré et classé en GED (P4).
  gedDocumentId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  client    ComClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote     ComQuote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  owner     User              @relation("ComContractOwner", fields: [ownerId], references: [id])
  createdBy User              @relation("ComContractCreator", fields: [createdById], references: [id])
  lines     ComContractLine[]
  invoices  ComInvoice[]

  @@index([clientId, status])
  @@index([ownerId])
  @@index([updatedAt])
  @@index([status, updatedAt])
  @@map("com_contracts")
}

model ComContractLine {
  id                    String                @id @default(cuid())
  contractId            String
  sortOrder             Int                   @default(0)
  label                 String
  description           String?
  qty                   Int                   @default(1)
  unitPrice             Int
  billing               CatalogBilling        @default(MONTHLY)
  status                ComContractLineStatus @default(ACTIF)
  startDate             DateTime?
  endDate               DateTime?
  nextBillAt            DateTime?
  catalogOfferId        String?
  catalogOfferVersionId String?
  /// Snapshot immuable tarifs / conditions à la signature.
  snapshotJson          Json
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  contract            ComContract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  catalogOffer        CatalogOffer?         @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)
  catalogOfferVersion CatalogOfferVersion?  @relation(fields: [catalogOfferVersionId], references: [id], onDelete: SetNull)
  invoiceLines        ComInvoiceLine[]

  @@index([contractId, status])
  @@index([nextBillAt])
  @@map("com_contract_lines")
}

model ComInvoice {
  id              String            @id @default(cuid())
  /// Numéro officiel (null tant que brouillon).
  number          String?           @unique
  draftCode       String            @unique
  legacyNumber    String?
  legacyInternalRef String?
  status          ComInvoiceStatus  @default(BROUILLON)
  source          ComInvoiceSource  @default(MANUAL)
  regime          ComDocRegime      @default(ML)
  currency        String            @default("XOF")
  vatEnabled      Boolean           @default(true)
  vatRate         Int               @default(18)
  object          String?
  periodStart     DateTime?
  periodEnd       DateTime?
  dueDate         DateTime?
  totalHt         Int               @default(0)
  totalVat        Int               @default(0)
  totalTtc        Int               @default(0)
  /// Dénormalisé depuis allocations (cache).
  amountPaid      Int               @default(0)
  /// Net à payer présenté (période + arriérés affichés − acomptes sur doc).
  presentedNetPayable Int?
  clientId        String
  quoteId         String?
  contractId      String?
  ownerId         String            @db.Uuid
  createdById     String            @db.Uuid
  gedDocumentId   String?
  issuedAt        DateTime?
  sentAt          DateTime?
  importBatchId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  client      ComClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote       ComQuote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contract    ComContract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  owner       User                   @relation("ComInvoiceOwner", fields: [ownerId], references: [id])
  createdBy   User                   @relation("ComInvoiceCreator", fields: [createdById], references: [id])
  importBatch ComImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  lines       ComInvoiceLine[]
  payments    ComPayment[]
  allocations ComPaymentAllocation[]
  arrearsRefs ComInvoiceArrearsRef[] @relation("InvoiceArrearsOn")
  arrearsOf   ComInvoiceArrearsRef[] @relation("InvoiceArrearsSource")
  creditNotes ComCreditNote[]
  reminders   ComInvoiceReminder[]

  @@index([clientId])
  @@index([ownerId, status])
  @@index([contractId])
  @@index([dueDate, status])
  @@index([legacyNumber])
  @@index([quoteId])
  @@map("com_invoices")
}

model ComInvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  sortOrder      Int     @default(0)
  label          String
  description    String?
  qty            Int     @default(1)
  unitPrice      Int
  catalogOfferId String?
  contractLineId String?
  isTravel       Boolean @default(false)
  snapshotJson   Json?

  invoice      ComInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  catalogOffer CatalogOffer?    @relation(fields: [catalogOfferId], references: [id], onDelete: SetNull)
  contractLine ComContractLine? @relation(fields: [contractLineId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("com_invoice_lines")
}

/// Présentation d’arriéré sur une facture (pas une nouvelle créance).
model ComInvoiceArrearsRef {
  id               String @id @default(cuid())
  invoiceId        String
  sourceInvoiceId  String
  presentedAmount  Int
  label            String?

  invoice       ComInvoice @relation("InvoiceArrearsOn", fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceInvoice ComInvoice @relation("InvoiceArrearsSource", fields: [sourceInvoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, sourceInvoiceId])
  @@index([sourceInvoiceId])
  @@map("com_invoice_arrears_refs")
}

model ComCreditNote {
  id            String   @id @default(cuid())
  number        String?  @unique
  draftCode     String   @unique
  legacyNumber  String?
  amount        Int
  reason        String?
  clientId      String
  invoiceId     String
  createdById   String   @db.Uuid
  gedDocumentId String?
  issuedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client    ComClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice   ComInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy User       @relation("ComCreditNoteCreator", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([invoiceId])
  @@map("com_credit_notes")
}

model ComPayment {
  id             String            @id @default(cuid())
  clientId       String
  /// Conservé pour compat Phase 3 ; préférer allocations.
  invoiceId      String?
  amount         Int
  method         ComPaymentMethod  @default(VIREMENT)
  status         ComPaymentStatus  @default(VALIDATED)
  paidAt         DateTime          @default(now())
  reference      String?
  note           String?
  gedDocumentId  String?
  recordedById   String            @db.Uuid
  importBatchId  String?
  createdAt      DateTime          @default(now())

  client      ComClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice     ComInvoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recordedBy  User                   @relation("ComPaymentRecorder", fields: [recordedById], references: [id])
  importBatch ComImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  allocations ComPaymentAllocation[]

  @@index([clientId])
  @@index([invoiceId])
  @@index([paidAt])
  @@map("com_payments")
}

model ComPaymentAllocation {
  id         String   @id @default(cuid())
  paymentId  String
  invoiceId  String
  amount     Int
  createdAt  DateTime @default(now())

  payment ComPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice ComInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("com_payment_allocations")
}

model ComClientEvent {
  id         String   @id @default(cuid())
  clientId   String
  type       String
  summary    String
  entityType String?
  entityId   String?
  metaJson   Json?
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  client ComClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor  User?     @relation("ComClientEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("com_client_events")
}

model ComInvoiceReminder {
  id          String   @id @default(cuid())
  invoiceId   String
  level       Int      @default(1)
  channel     String
  content     String?
  result      String?
  nextAction  String?
  sentAt      DateTime @default(now())
  createdById String?  @db.Uuid

  invoice ComInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sentAt])
  @@map("com_invoice_reminders")
}

model ComImportBatch {
  id          String               @id @default(cuid())
  label       String
  status      ComImportBatchStatus @default(DRY_RUN)
  sourceName  String?
  reportJson  Json?
  createdById String               @db.Uuid
  committedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy User                 @relation("ComImportBatchCreator", fields: [createdById], references: [id])
  anomalies ComImportAnomaly[]
  invoices  ComInvoice[]
  payments  ComPayment[]

  @@index([status])
  @@map("com_import_batches")
}

model ComImportAnomaly {
  id        String                    @id @default(cuid())
  batchId   String
  code      String
  severity  ComImportAnomalySeverity  @default(WARNING)
  message   String
  entityRef String?
  metaJson  Json?
  resolved  Boolean                   @default(false)
  createdAt DateTime                  @default(now())

  batch ComImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, resolved])
  @@map("com_import_anomalies")
}

// ─── Phase 6 — Comptabilité SYSCOHADA + banques + budget ───

enum CptAccountNature {
  ASSET
  LIABILITY
  EQUITY
  EXPENSE
  INCOME
}

enum CptExerciseStatus {
  OPEN
  CLOSED
}

enum CptPeriodStatus {
  OPEN
  CLOSED
}

enum CptEntryStatus {
  DRAFT
  VALIDATED
}

enum BudNature {
  CAPEX
  OPEX
}

enum BudPatenteStatus {
  PENDING
  PAID
  OVERDUE
}

/// Plan de comptes SYSCOHADA (minimal PME, extensible)
model CptAccount {
  id         String           @id @default(cuid())
  code       String           @unique
  label      String
  classNum   Int
  nature     CptAccountNature
  isPostable Boolean          @default(true)
  active     Boolean          @default(true)
  parentId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  parent   CptAccount?  @relation("CptAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CptAccount[] @relation("CptAccountTree")
  lines    CptEntryLine[]
  banks    CptBankAccount[]

  @@index([classNum, code])
  @@index([active, isPostable])
  @@map("cpt_accounts")
}

model CptJournal {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CptEntry[]

  @@map("cpt_journals")
}

model CptExercise {
  id        String            @id @default(cuid())
  year      Int               @unique
  status    CptExerciseStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  periods CptPeriod[]

  @@map("cpt_exercises")
}

model CptPeriod {
  id         String          @id @default(cuid())
  exerciseId String
  month      Int
  status     CptPeriodStatus @default(OPEN)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  exercise CptExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  entries  CptEntry[]

  @@unique([exerciseId, month])
  @@index([status])
  @@map("cpt_periods")
}

model CptEntry {
  id               String         @id @default(cuid())
  number           String         @unique
  journalId        String
  periodId         String
  entryDate        DateTime       @db.Date
  label            String
  status           CptEntryStatus @default(DRAFT)
  sourceType       String?
  sourceId         String?
  currencyOriginal String?
  fxRate           Decimal?       @db.Decimal(12, 6)
  amountOriginal   Int?
  createdById      String         @db.Uuid
  validatedById    String?        @db.Uuid
  validatedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  journal     CptJournal     @relation(fields: [journalId], references: [id])
  period      CptPeriod      @relation(fields: [periodId], references: [id])
  createdBy   User           @relation("CptEntryCreator", fields: [createdById], references: [id])
  validatedBy User?          @relation("CptEntryValidator", fields: [validatedById], references: [id])
